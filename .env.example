# Database Configuration
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Server Configuration
# PORT=3000 choca con otros proyectos locales (ej. un frontend Vite) que
# también usan 3000 por defecto; se usa 3001 para evitar el conflicto.
PORT=3001
APP_URL=http://localhost:3001
NODE_ENV=

# JWT Configuration
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo 32 caracteres requeridos
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Admin User Configuration (for scripts)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NOMBRE=

# Correo / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Sentry (opcional) — obtener en sentry.io
# Si está vacío, el error tracking queda deshabilitado
SENTRY_DSN=

# Google Analytics 4 (opcional) — Measurement ID (G-XXXXXXXXXX) desde
# analytics.google.com > Administrar > Flujos de datos > tu flujo Web.
# Si está vacío, el tag de analítica no se imprime en ninguna página.
GA_MEASUREMENT_ID=

# Wompi (opcional) — pasarela de pagos para el cobro automático de la
# suscripción de cada tenant. Llaves desde el dashboard de Wompi
# (panel.wompi.co > Desarrolladores). Si WOMPI_PRIVATE_KEY está vacío, el
# cron de cobro simplemente no encuentra tenants con tarjeta registrada
# (nadie puede registrar una sin WOMPI_PUBLIC_KEY en el frontend).
# WOMPI_INTEGRITY_SECRET es obligatorio si se usa el cobro automático:
# Wompi exige la firma de integridad en toda creación de transacción.
# WOMPI_EVENTS_SECRET valida la firma de los webhooks de Wompi.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# E2E Tests (Playwright) — credenciales del usuario de prueba
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_USER=admin
E2E_ADMIN_PASS=admin123

