<%- include('../partials/layout/head', { titulo: 'Fidelización - ' + tenant.nombre }) %>
    <link rel="stylesheet" href="/css/modulos/fidelizacion.css?v=<%= assetV %>">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

    <div class="container py-4" id="fidelizacionApp" data-puede-gestionar="<%= puedeGestionar ? '1' : '0' %>">
        <div class="mb-4">
            <h2 class="fw-bold"><i class="bi bi-stars me-2 text-primary"></i>Fidelización</h2>
            <p class="text-muted mb-0">
                Tarjeta de sellos digital: el cliente la guarda en Google Wallet y cada factura le suma un sello
                automáticamente. Al completarla gana el premio.
            </p>
        </div>

        <div class="row g-4 mb-4">
            <!-- Programa -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Programa de sellos</h5>
                        <form id="formPrograma" class="row g-3">
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="pNombre">Nombre del programa</label>
                                <input class="form-control" id="pNombre" maxlength="80" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1" for="pSellos">Sellos para ganar el premio</label>
                                <input class="form-control" id="pSellos" type="number" min="2" max="20" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="pModo">¿Cuándo se gana un sello?</label>
                                <select class="form-select" id="pModo">
                                    <option value="monto">Por el valor de la compra</option>
                                    <option value="producto">Al comprar un producto de la carta</option>
                                </select>
                            </div>
                            <div class="col-12" id="grupoMonto">
                                <label class="form-label small text-muted mb-1" for="pMonto">Compra mínima por sello ($)</label>
                                <input class="form-control" id="pMonto" type="number" min="0" step="1000" value="0">
                                <div class="form-text">0 = cualquier venta a un cliente con tarjeta suma un sello.</div>
                            </div>
                            <div class="col-12 d-none" id="grupoProducto">
                                <label class="form-label small text-muted mb-1" for="pProducto">Producto que da el sello</label>
                                <select class="form-select" id="pProducto"></select>
                                <div class="form-text">
                                    El sello se suma cuando la venta del cliente incluye este producto (un sello por venta,
                                    sin importar cuántas unidades lleve). Si no lo incluye, no suma.
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="pPremio">Premio</label>
                                <input class="form-control" id="pPremio" maxlength="120" placeholder="Ej: Un postre de la casa" required>
                            </div>
                            <div class="col-12 d-flex align-items-center justify-content-between">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="pActivo">
                                    <label class="form-check-label" for="pActivo">Programa activo</label>
                                </div>
                                <button class="btn btn-primary" type="submit" id="btnGuardarPrograma">
                                    <i class="bi bi-check2 me-1"></i>Guardar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- QR de inscripción -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body text-center">
                        <h5 class="fw-bold mb-1">QR de inscripción</h5>
                        <p class="text-muted small">Imprímelo en el local: el cliente lo escanea, llena sus datos y recibe su tarjeta.</p>
                        <div id="qrVacio" class="text-muted small py-4">Guarda y activa el programa para generar el QR.</div>
                        <div id="qrContenido" class="d-none">
                            <img id="qrImagen" alt="QR de inscripción" class="img-fluid rounded-3 border mb-2" style="max-width: 220px">
                            <div class="input-group input-group-sm mb-2">
                                <input class="form-control" id="qrUrl" readonly>
                                <button class="btn btn-outline-secondary" type="button" id="btnCopiarQr" title="Copiar enlace"><i class="bi bi-clipboard"></i></button>
                            </div>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <a class="btn btn-sm btn-primary" href="/api/fidelizacion/inscripcion/tarjeta.pdf" target="_blank" rel="noopener"><i class="bi bi-printer me-1"></i>Tarjeta para imprimir</a>
                                <a class="btn btn-sm btn-outline-primary" id="btnDescargarQr" download="qr-fidelizacion.png"><i class="bi bi-download me-1"></i>Solo el QR</a>
                                <button class="btn btn-sm btn-outline-danger" type="button" id="btnRegenerarQr"><i class="bi bi-arrow-repeat me-1"></i>Generar QR nuevo</button>
                            </div>
                            <div class="form-text mt-2">"Generar QR nuevo" deja de funcionar el anterior (úsalo si se filtró o se imprimió mal).</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Diseño de la tarjeta: se guarda junto con el programa (mismo formulario) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Diseño de la tarjeta</h5>
                        <p class="text-muted small mb-0">
                            Así verán tu tarjeta tus clientes en Google Wallet, y es el mismo diseño de la tarjeta con QR que imprimes.
                        </p>
                    </div>
                    <button class="btn btn-primary" type="submit" form="formPrograma" id="btnGuardarDiseno">
                        <i class="bi bi-check2 me-1"></i>Guardar diseño
                    </button>
                </div>
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fid-disenos" id="disenos" role="radiogroup" aria-label="Diseños de tarjeta">
                            <div class="text-muted small">Cargando diseños…</div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="fid-previa">
                            <img id="disenoPrevia" alt="Vista previa de la tarjeta en Wallet" class="img-fluid rounded-3 border">
                            <div class="mt-3">
                                <label class="form-label small text-muted mb-1" for="pLema">Lema (opcional)</label>
                                <input class="form-control" id="pLema" maxlength="60" placeholder="Ej: Sabor de casa desde 1998">
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-3">
                                <input type="color" class="form-control form-control-color" id="pColor" value="#7c3f1d" title="Color de acento">
                                <label class="small text-muted mb-0" for="pColor">Color de acento</label>
                                <button class="btn btn-sm btn-link ms-auto" type="button" id="btnColorOriginal">Color original</button>
                            </div>
                            <div class="mt-3">
                                <div class="form-label small text-muted mb-1">Logo en la tarjeta</div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="pMostrarLogo" checked>
                                    <label class="form-check-label small" for="pMostrarLogo">Mostrar logo</label>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap" id="logoControles">
                                    <img id="logoMuestra" alt="" class="fid-logo-muestra d-none">
                                    <label class="btn btn-sm btn-outline-primary mb-0" for="inputLogo"><i class="bi bi-upload me-1"></i>Subir logo propio</label>
                                    <input type="file" id="inputLogo" class="d-none" accept="image/png,image/jpeg,image/webp,image/gif">
                                    <button class="btn btn-sm btn-outline-secondary d-none" type="button" id="btnLogoNegocio">Usar el logo del negocio</button>
                                </div>
                                <div class="form-text" id="logoAyuda"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjetas -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Tarjetas de clientes</h5>
                    <input class="form-control" id="filtroTarjetas" style="max-width: 280px" placeholder="Buscar por nombre, celular o número">
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>Cliente</th><th>Tarjeta</th><th>Sellos</th><th>Premios</th><th class="text-end">Acciones</th></tr>
                        </thead>
                        <tbody id="tbodyTarjetas"><tr><td colspan="5" class="text-muted text-center py-4">Cargando…</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
    <script src="/js/modulos/fidelizacion.js?v=<%= assetV %>"></script>
</body>

</html>
