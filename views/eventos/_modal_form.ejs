<!-- Modal crear/editar -->
<div class="modal fade" id="modalEvento" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEventoTitle"><i class="bi bi-calendar-plus me-2"></i>Nuevo evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="eventoId" value="">
                <div class="mb-3">
                    <label for="eventoNombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="eventoNombre" placeholder="Ej: Feria navideña" required>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label for="eventoFechaInicio" class="form-label">Fecha inicio</label>
                        <input type="date" class="form-control" id="eventoFechaInicio" required>
                    </div>
                    <div class="col-6">
                        <label for="eventoFechaFin" class="form-label">Fecha fin</label>
                        <input type="date" class="form-control" id="eventoFechaFin" required>
                    </div>
                </div>
                <div class="mb-3 mt-2">
                    <label for="eventoDescripcion" class="form-label">Descripción (opcional)</label>
                    <textarea class="form-control" id="eventoDescripcion" rows="2"
                        placeholder="Descripción del evento"></textarea>
                </div>
                <div class="form-check form-switch mb-3">
                    <input type="checkbox" class="form-check-input" id="eventoIncluirVentas" role="switch">
                    <label class="form-check-label fw-semibold" for="eventoIncluirVentas">Incluir en las ventas normales</label>
                    <div class="form-text">
                        Activado: sus ventas cuentan en los ingresos, la ganancia y las estadísticas del día y del mes,
                        incluidas las que ya registraste. Desactivado: quedan aparte, solo dentro del evento.
                    </div>
                </div>
                <div class="form-check" id="wrapActivo">
                    <input type="checkbox" class="form-check-input" id="eventoActivo" checked>
                    <label class="form-check-label" for="eventoActivo">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarEvento"><i
                        class="bi bi-check-lg me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>