<%- include('../partials/layout/head', { titulo: 'Eventos' }) %>
    <link rel="stylesheet" href="/css/modulos/eventos.css?v=<%= assetV %>">
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null, tenant: typeof tenant
        !=='undefined' ? tenant : null }) %>

        <div class="container mt-4">
            <div class="card">
                <div class="card-header">
                    <div
                        class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 w-100">
                        <div class="fw-semibold">
                            <i class="bi bi-calendar-event me-2"></i>Eventos
                        </div>
                        <% if (user && user.permisos && user.permisos.includes('eventos.crear')) { %>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                    data-bs-target="#modalEvento" id="btnNuevoEvento">
                                    <i class="bi bi-plus-lg me-1"></i>Nuevo evento
                                </button>
                            </div>
                            <% } %>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Las ventas de un evento están <strong>separadas</strong> de la estadística de ventas general diaria/mensual (mostrador), salvo que lo marques como <strong>«Incluir en las ventas normales»</strong>: entonces cuentan en ingresos, ganancia y estadísticas. Crea eventos y, al facturar, asocia la venta a
                        un evento si corresponde.</p>

                    <%- include('_table', { eventos: eventos }) %>
                </div>
            </div>
        </div>

        <%- include('_modal_form') %>

            <%- include('../partials/layout/scripts', { swal: true }) %>
            <script src="/js/modulos/eventos.js?v=<%= assetV %>"></script>
</body>

</html>