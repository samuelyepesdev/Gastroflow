<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Reservar en <%= vista.restaurante %></title>
    <link rel="icon" href="/brand/favicon/favicon.svg" type="image/svg+xml">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/core/brand.css?v=<%= assetV %>">
    <link rel="stylesheet" href="/css/modulos/reservas-publica.css?v=<%= assetV %>">
    <% if (vista.tema) { %><link rel="stylesheet" href="/css/core/tema-navidad.css?v=<%= assetV %>"><% } %>
</head>
<body<% if (vista.tema) { %> class="tema-navidad<%= vista.tema.animaciones ? '' : ' tema-navidad-quieto' %>"<% } %>>
    <header class="rp-cabecera<%= vista.tema ? ' rp-cabecera--tema' : '' %>">
        <% if (vista.tema) { %><%- include('../partials/_tema_navidad', { parte: 'luces', variante: 'sobre', adornos: true }) %><% } %>
        <h1 class="rp-restaurante"><%= vista.restaurante %></h1>
        <p class="rp-sub">Reserva tu mesa</p>
    </header>

    <main class="rp-wrap">
        <% if (vista.tema) { %><%- include('../partials/_tema_navidad', { parte: 'banner', tema: vista.tema }) %><% } %>
        <div id="rpFormulario">
            <% if (vista.mensaje) { %>
                <p class="rp-mensaje"><i class="bi bi-stars" aria-hidden="true"></i> <%= vista.mensaje %></p>
            <% } %>

            <form id="rpForm" novalidate autocomplete="on">
                <input type="hidden" id="rpPersonas" name="personas" value="2">

                <!-- Paso 1: cuántos y qué día -->
                <section class="rp-paso" aria-labelledby="rpP1">
                    <h2 class="rp-paso-titulo" id="rpP1"><span class="rp-num">1</span>¿Cuántos son y qué día vienen?</h2>

                    <div class="rp-fila">
                        <span class="rp-etiqueta" id="rpPersonasLabel">Personas</span>
                        <div class="rp-stepper" role="group" aria-labelledby="rpPersonasLabel">
                            <button type="button" class="rp-step-btn" id="rpMenos" aria-label="Una persona menos"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                            <output class="rp-step-valor" id="rpPersonasTxt" aria-live="polite">2</output>
                            <button type="button" class="rp-step-btn" id="rpMas" aria-label="Una persona más"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                        </div>
                    </div>

                    <div class="rp-fila">
                        <label class="rp-etiqueta" for="rpFecha">Día</label>
                        <div class="rp-dia">
                            <div class="rp-chips" role="group" aria-label="Atajos de día">
                                <button type="button" class="rp-chip" data-dia="0">Hoy</button>
                                <button type="button" class="rp-chip" data-dia="1">Mañana</button>
                            </div>
                            <input type="date" class="form-control" id="rpFecha" name="fecha" min="<%= hoy %>" value="<%= hoy %>" required>
                        </div>
                    </div>
                </section>

                <!-- Paso 2: hora (solo las que tienen lugar) -->
                <section class="rp-paso" aria-labelledby="rpP2">
                    <h2 class="rp-paso-titulo" id="rpP2"><span class="rp-num">2</span>¿A qué hora?</h2>
                    <div id="rpHoras" class="rp-horas" role="radiogroup" aria-labelledby="rpP2"></div>
                    <p id="rpHorasInfo" class="rp-ayuda" aria-live="polite"></p>
                </section>

                <% if (vista.elegir_mesa) { %>
                <!-- Paso 3: mesa (solo las libres a esa hora) -->
                <section class="rp-paso rp-bloqueado" id="rpPasoMesa" aria-labelledby="rpP3">
                    <h2 class="rp-paso-titulo" id="rpP3"><span class="rp-num">3</span>Elige tu mesa</h2>
                    <div id="rpMesas" class="rp-mesas" role="radiogroup" aria-labelledby="rpP3"></div>
                    <p id="rpMesasInfo" class="rp-ayuda" aria-live="polite">Primero elige la hora.</p>
                </section>
                <% } %>

                <!-- Paso final: datos -->
                <section class="rp-paso rp-bloqueado" id="rpPasoDatos" aria-labelledby="rpP4">
                    <h2 class="rp-paso-titulo" id="rpP4"><span class="rp-num"><%= vista.elegir_mesa ? 4 : 3 %></span>Tus datos</h2>
                    <p id="rpDatosAyuda" class="rp-ayuda"><%= vista.elegir_mesa ? 'Primero elige la hora y la mesa.' : 'Primero elige la hora.' %></p>

                    <fieldset id="rpDatos" disabled>
                        <div class="mb-3">
                            <label for="rpNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control form-control-lg" id="rpNombre" name="nombre" maxlength="80" autocomplete="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="rpTelefono" class="form-label">Celular (te escribiremos por WhatsApp)</label>
                            <input type="tel" class="form-control form-control-lg" id="rpTelefono" name="telefono" inputmode="numeric" maxlength="16" autocomplete="tel" placeholder="3001234567" required>
                        </div>

                        <details class="rp-extra">
                            <summary>Agregar detalles (opcional)</summary>
                            <div class="mt-3">
                                <label for="rpEmail" class="form-label">Correo</label>
                                <input type="email" class="form-control mb-3" id="rpEmail" name="email" maxlength="120" autocomplete="email">
                                <label for="rpOcasion" class="form-label">¿Es una celebración?</label>
                                <select class="form-select mb-3" id="rpOcasion" name="ocasion">
                                    <option value="">No</option>
                                    <option value="cumpleanos">Cumpleaños</option>
                                    <option value="aniversario">Aniversario</option>
                                    <option value="empresarial">Empresarial</option>
                                    <option value="navidad">Navidad / Fin de año</option>
                                    <option value="otra">Otra</option>
                                </select>
                                <label for="rpNotas" class="form-label">Notas para el restaurante</label>
                                <input type="text" class="form-control" id="rpNotas" name="notas" maxlength="300" placeholder="Alergias, silla para bebé, torta...">
                            </div>
                        </details>

                        <input class="rp-hp" name="web" tabindex="-1" autocomplete="off" aria-hidden="true">

                        <div class="form-check rp-consent mt-3">
                            <input class="form-check-input" type="checkbox" id="rpConsent" name="consentimiento" value="1" required>
                            <label class="form-check-label" for="rpConsent">
                                Autorizo a <strong><%= vista.restaurante %></strong> a usar mis datos para gestionar esta reserva y contactarme.
                                <a href="/legal/privacidad" target="_blank" rel="noopener">Política de privacidad</a>.
                            </label>
                        </div>

                        <div id="rpResumen" class="rp-resumen" aria-live="polite"></div>
                        <div id="rpError" class="alert alert-danger d-none" role="alert"></div>

                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-primary btn-lg" id="rpEnviar">Confirmar reserva</button>
                        </div>
                    </fieldset>
                </section>
            </form>
        </div>

        <section id="rpListo" class="rp-card rp-listo d-none" aria-live="polite" tabindex="-1">
            <i class="bi bi-calendar2-check rp-listo-icono" aria-hidden="true"></i>
            <h2 class="rp-titulo" id="rpListoTitulo">¡Solicitud recibida!</h2>
            <p class="rp-listo-resumen" id="rpListoResumen"></p>
            <p id="rpListoTexto"></p>
            <button type="button" class="btn btn-outline-secondary" id="rpOtra">Hacer otra reserva</button>
        </section>
    </main>

    <footer class="rp-pie">
        <img src="/brand/isotipo/isotipo-color.svg" alt="" width="20" height="20">
        <span>Reservas con GastroFlow</span>
    </footer>

    <script>
        window.RESERVA_PUBLICA = <%- jsonSeguro({ token, hoy, maxPersonas: vista.max_personas, elegirMesa: !!vista.elegir_mesa }) %>;
    </script>
    <% if (vista.tema) { %><script src="/js/core/tema-navidad.js?v=<%= assetV %>"></script><% } %>
    <script src="/js/modulos/reservas-publica.js?v=<%= assetV %>"></script>
</body>
</html>
