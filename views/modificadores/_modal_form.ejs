<!-- Modal Grupo de Modificadores -->
<div class="modal fade" id="modalGrupo" tabindex="-1">
        <div class="modal-dialog modal-lg">
                <div class="modal-content">
                        <div class="modal-header">
                                <h5 class="modal-title" id="modalGrupoTitulo">
                                        <i class="bi bi-list-check me-2"></i>Nuevo grupo de toppings
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                                <input type="hidden" id="grupoId">

                                <div class="mb-3" id="grupoPlantillasWrap">
                                        <label class="form-label fw-semibold small text-muted text-uppercase">¿Empezar
                                                desde una plantilla?</label>
                                        <div class="d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-plantilla"
                                                        data-plantilla="salsas"><i class="bi bi-egg-fried me-1"></i>Salsas</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-plantilla"
                                                        data-plantilla="tamanos"><i class="bi bi-rulers me-1"></i>Tamaños</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-plantilla"
                                                        data-plantilla="extras"><i class="bi bi-plus-circle me-1"></i>Toppings extra</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-plantilla"
                                                        data-plantilla="picante"><i class="bi bi-fire me-1"></i>Nivel de picante</button>
                                        </div>
                                        <div class="form-text mt-1">Elige una y ajusta los nombres/precios a tu gusto,
                                                o arma el grupo desde cero abajo.</div>
                                </div>

                                <hr class="my-3">

                                <div class="mb-3">
                                        <label class="form-label fw-semibold">Nombre del grupo <span
                                                        class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="grupoNombre"
                                                placeholder="Ej: Elige tu salsa, Toppings extra">
                                </div>

                                <div class="mb-3">
                                        <label class="form-label fw-semibold">¿El cliente puede elegir varias opciones
                                                a la vez?</label>
                                        <div class="btn-group w-100" role="group">
                                                <button type="button" class="btn btn-outline-primary grupo-seleccion-btn active"
                                                        data-valor="unica">No, solo una <span class="d-none d-sm-inline">(ej: la salsa)</span></button>
                                                <button type="button" class="btn btn-outline-primary grupo-seleccion-btn"
                                                        data-valor="multiple">Sí, varias <span class="d-none d-sm-inline">(ej: toppings extra)</span></button>
                                        </div>
                                        <input type="hidden" id="grupoTipoSeleccion" value="unica">
                                </div>

                                <div class="mb-3">
                                        <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="grupoObligatorio">
                                                <label class="form-check-label" for="grupoObligatorio">
                                                        El cliente debe elegir algo aquí obligatoriamente
                                                </label>
                                        </div>
                                </div>

                                <div class="mb-3">
                                        <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="grupoDescuentaInventario">
                                                <label class="form-check-label" for="grupoDescuentaInventario">
                                                        Descontar del inventario al vender (ligar cada opción con un insumo)
                                                </label>
                                        </div>
                                        <div class="form-text">Si lo activas, cada opción de abajo pedirá qué insumo
                                                consume y cuánto. Si no, los toppings funcionan como siempre (solo nombre
                                                y precio).</div>
                                </div>

                                <div class="mb-3" id="grupoAvanzadoTrigger">
                                        <button class="btn btn-link btn-sm px-0" type="button" data-bs-toggle="collapse"
                                                data-bs-target="#grupoAvanzado">
                                                <i class="bi bi-sliders me-1"></i>Opciones avanzadas (límite de cuántas puede elegir)
                                        </button>
                                        <div class="collapse" id="grupoAvanzado">
                                                <div class="row mt-2">
                                                        <div class="mb-2 col-md-6">
                                                                <label class="form-label small text-muted">Mínimo que debe
                                                                        elegir</label>
                                                                <input type="number" min="0" class="form-control form-control-sm"
                                                                        id="grupoMinimo" value="0">
                                                        </div>
                                                        <div class="mb-2 col-md-6">
                                                                <label class="form-label small text-muted">Máximo que puede
                                                                        elegir</label>
                                                                <input type="number" min="1" class="form-control form-control-sm"
                                                                        id="grupoMaximo" placeholder="Vacío = sin límite">
                                                        </div>
                                                </div>
                                        </div>
                                </div>

                                <hr class="my-3">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                                <label class="form-label fw-semibold mb-0">Opciones</label>
                                                <div class="form-text mt-0">Ej: "BBQ", "Tocineta". El precio extra es
                                                        opcional (déjalo en 0 si no cobras adicional).</div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                id="btnAgregarOpcion">
                                                <i class="bi bi-plus-lg me-1"></i> Agregar opción
                                        </button>
                                </div>

                                <div class="table-responsive">
                                        <table class="table table-sm mb-0" id="grupoOpcionesTabla">
                                                <thead>
                                                        <tr class="table-light small text-muted">
                                                                <th>Nombre</th>
                                                                <th style="width:120px">Precio extra</th>
                                                                <th class="col-inventario d-none" style="width:190px">Insumo</th>
                                                                <th class="col-inventario d-none" style="width:130px">Cantidad</th>
                                                                <th style="width:60px"></th>
                                                        </tr>
                                                </thead>
                                                <tbody id="grupoOpcionesContainer"></tbody>
                                        </table>
                                </div>
                        </div>

                        <script type="application/json" id="modificadores-insumos-data"><%- JSON.stringify(typeof insumos !== 'undefined' ? insumos : []) %></script>
                        <div class="modal-footer">
                                <button type="button" class="btn btn-secondary"
                                        data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary" id="btnGuardarGrupo">
                                        <i class="bi bi-check-lg me-1"></i> Guardar grupo
                                </button>
                        </div>
                </div>
        </div>
</div>
