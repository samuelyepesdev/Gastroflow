<%- include('../partials/layout/head', { titulo: 'Historial de Ventas' }) %>
    <link rel="stylesheet" href="/css/modulos/ventas.css?v=<%= assetV %>">
    <% const activeAccent = colorAcento(typeof tenant !== 'undefined' ? tenant : null) %>
    <%- include('../partials/layout/accent-vars', { color: activeAccent, selector: ':root' }) %>
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null, tenant: typeof tenant !== 'undefined' ? tenant : null }) %>

    <div class="container animate__animated animate__fadeIn">
        
        <!-- Header Section -->
        <div class="page-header-container">
            <div class="page-title-section">
                <span class="page-title-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </span>
                <div class="page-title-text">
                    <h1>Historial de ventas</h1>
                    <p>Consulta y reimprime facturas por periodo</p>
                </div>
            </div>
        </div>

        <!-- Event Filter Banner -->
        <% if (typeof eventoFiltro !== 'undefined' && eventoFiltro) { %>
            <div class="alert alert-info py-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 border-0 shadow-sm" style="border-radius: 12px; background: #fff0eb; color: #1e3a8a;">
                <span>
                    <i class="bi bi-calendar-event me-2" style="font-size: 16px;"></i>
                    Ventas del evento: <strong><%= eventoFiltro.nombre %></strong>
                </span>
                <a href="/ventas" class="btn btn-sm btn-outline-primary" style="border-radius: 8px; font-weight: 700;">Ver todas las ventas</a>
            </div>
        <% } %>

        <!-- Tables Ready to Pay (Mesas Listas para Pagar) -->
        <% if (typeof mesasListas !== 'undefined' && mesasListas.length > 0) { %>
            <div class="premium-table-card mb-4" style="border-color: #ff5a36; overflow: hidden;">
                <div class="p-3 text-white d-flex align-items-center gap-2" style="background: #ff5a36;">
                    <i class="bi bi-cash-coin" style="font-size: 1.2rem;"></i>
                    <h5 class="mb-0 fw-bold">Mesas Listas para Pagar</h5>
                </div>
                <div class="p-4" style="background: #fff9f2;">
                    <div class="row g-3">
                        <% mesasListas.forEach(function(mesa) { %>
                            <div class="col-md-4 col-lg-3">
                                <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; background: #fff; border: 1px solid #e4dccf !important;">
                                    <div class="card-body text-center p-3">
                                        <h5 class="card-title fw-bold text-dark mb-1">Mesa <%= mesa.mesa_numero %></h5>
                                        <p class="card-text mb-3" style="font-size: 13px; color: #5b6b7e;">
                                            <strong>Pedido #<%= mesa.pedido_id %></strong><br>
                                            <span class="text-primary fw-bold">Total: $<%= (Number(mesa.pedido_total) || 0).toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                        </p>
                                        <button class="btn btn-primary btn-sm w-100 py-2" style="border-radius: 8px; font-weight: 700; border: none;" onclick="window.location.href='/mesas?pedido=<%= mesa.pedido_id %>'">
                                            <i class="bi bi-cash-stack me-1"></i> Facturar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Filters Section -->
        <%- include('_filters') %>

        <!-- KPI Metrics Summary Cards -->
        <%- include('_summary') %>

        <!-- Main Grouped Sales Table -->
        <%- include('_table_grouped') %>

    </div>

    <!-- Modals -->
    <%- include('_modales') %>

    <!-- Base Scripts -->
    <%- include('../partials/layout/scripts', { jquery: true }) %>
    <script src="/js/modulos/ventas.js?v=<%= assetV %>"></script>
</body>

</html>