<%
const fmtNum = (n) => '$ ' + (Number(n) || 0).toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
// Los montos son SIEMPRE del día de hoy (neto = venta − servicios externos),
// independientes del rango de fechas de arriba (que solo filtra la tabla).
const vHoy = (typeof ventasHoy !== 'undefined' && ventasHoy) ? ventasHoy : { efectivo: 0, transferencia: 0, total: 0 };
%>

<div class="kpis-grid">
    <!-- Efectivo (hoy) -->
    <div class="kpi-card">
        <div class="kpi-card-header">
            <span class="kpi-card-icon" style="background: var(--accentSoft); color: var(--accent);"><i class="bi bi-cash"></i></span>
            <span class="kpi-card-title">Efectivo (hoy)</span>
        </div>
        <div class="kpi-card-value" id="totalEfectivoVal"><%= fmtNum(vHoy.efectivo) %></div>
    </div>

    <!-- Transferencia (hoy) -->
    <div class="kpi-card">
        <div class="kpi-card-header">
            <span class="kpi-card-icon" style="background: #fff0eb; color: #e8431f;"><i class="bi bi-bank"></i></span>
            <span class="kpi-card-title">Transferencia (hoy)</span>
        </div>
        <div class="kpi-card-value" id="totalTransferenciaVal"><%= fmtNum(vHoy.transferencia) %></div>
    </div>

    <!-- Total Neto (hoy) -->
    <div class="kpi-card-gradient">
        <div class="kpi-card-header">
            <span class="kpi-card-icon" style="background: rgba(255, 255, 255, 0.18); color: #fff;"><i class="bi bi-wallet2"></i></span>
            <span class="kpi-card-title">Total Neto (hoy)</span>
        </div>
        <div class="kpi-card-value" id="totalGeneralVal"><%= fmtNum(vHoy.total) %></div>
    </div>

    <!-- Facturas Hoy -->
    <div class="kpi-card">
        <div class="kpi-card-header">
            <span class="kpi-card-icon" style="background: var(--accentSoft); color: var(--accent);"><i class="bi bi-receipt"></i></span>
            <span class="kpi-card-title">Facturas Hoy</span>
        </div>
        <div class="kpi-card-value" id="facturasHoyVal"><%= vHoy.facturas || 0 %></div>
    </div>
</div>
