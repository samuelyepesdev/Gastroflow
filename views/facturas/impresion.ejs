<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Factura #<%= typeof factura.numero !=='undefined' && factura.numero !=null ? factura.numero : factura.id %>
    </title>
    <link rel="stylesheet" href="/css/core/factura.css">
</head>

<body>


    <div class="factura">
        <img id="previewLogoImg" src="<%= config.logo_src || '' %>" alt="Logo" class="logo mb-3"
            style="<%= config.logo_src ? '' : 'display:none' %>">

                <div class="text-center mb-3">
                    <h2 style="margin: 0; text-transform: uppercase; letter-spacing: 1px;">
                        <%= config.nombre_negocio || tenant.nombre %>
                    </h2>

                    <% if (tenant.regimen_fiscal) { %>
                        <div class="small fw-bold">
                            <%= tenant.regimen_fiscal %>
                        </div>
                        <% } %>

                            <div class="small">
                                <% if (config.nit || tenant.nit) { %>
                                    <span>NIT: <%= config.nit || tenant.nit %></span><br>
                                    <% } %>
                                        <% if (config.direccion || tenant.direccion) { %>
                                            <span>
                                                <%= config.direccion || tenant.direccion %>
                                            </span>
                                            <% if (tenant.ciudad) { %> - <%= tenant.ciudad %>
                                                    <% } %>
                                                        <br>
                                                        <% } %>
                                                            <% if (config.telefono || tenant.telefono) { %>
                                                                <span>Tel: <%= config.telefono || tenant.telefono %>
                                                                </span>
                                                                <% } %>
                            </div>
                </div>

                <div class="divider"></div>

                <div class="mb-3">
                    <div>Factura #: <%= typeof factura.numero !=='undefined' && factura.numero !=null ? factura.numero :
                            factura.id %>
                    </div>
                    <div>Fecha: <span id="fechaFactura" data-fecha-iso="<%= factura.fechaISO || '' %>">
                            <%= factura.fechaISO ? '' : (factura.fecha ? new Date(factura.fecha).toLocaleString('es-CO',
                                { timeZone: 'America/Bogota' , dateStyle: 'short' , timeStyle: 'medium' }) : '' ) %>
                        </span></div>
                </div>

                <div class="mb-3">
                    <div><strong>Cliente:</strong>
                        <%= factura.cliente_nombre %>
                    </div>
                    <% if (factura.direccion) { %>
                        <div><strong>Dirección:</strong>
                            <%= factura.direccion %>
                        </div>
                        <% } %>
                            <% if (factura.telefono) { %>
                                <div><strong>Teléfono:</strong>
                                    <%= factura.telefono %>
                                </div>
                                <% } %>
                                    <% if (typeof factura.evento_nombre !=='undefined' && factura.evento_nombre) { %>
                                        <div class="mt-2 text-primary" style="font-weight: bold;">
                                            Venta de Evento: <%= factura.evento_nombre %>
                                        </div>
                                        <% } %>
                </div>

                <div class="divider"></div>

                <div class="productos-lista">
                    <% detalles.forEach(function(item) { %>
                        <div class="producto-item">
                            <div class="producto-detalles" style="padding-left: 0;">
                                <div class="producto-nombre"
                                    style="margin: 0; font-weight: bold; font-size: 1.2em; flex: 3; text-transform: uppercase;">
                                    <%= item.producto_nombre %> <%= item.es_servicio ? '(SERVICIO)' : '' %>
                                    <% if (item.modificadores && item.modificadores.length) { %>
                                        <div style="font-size: 0.65em; font-weight: normal; text-transform: none; color: #555;">
                                            <%= item.modificadores.map(m => m.opcion_nombre).join(', ') %>
                                        </div>
                                    <% } %>
                                    <% if (item.descuento_valor != null && Number(item.descuento_valor) > 0) { %>
                                        <div style="font-size: 0.65em; font-weight: normal; text-transform: none; color: #555;">
                                            Descuento: -$<%= Number(item.descuento_valor).toLocaleString('es-CO') %>
                                        </div>
                                    <% } else if (item.descuento_porcentaje != null && Number(item.descuento_porcentaje) > 0) { %>
                                        <div style="font-size: 0.65em; font-weight: normal; text-transform: none; color: #555;">
                                            Descuento: -<%= Number(item.descuento_porcentaje) %>%
                                        </div>
                                    <% } %>
                                </div>
                                <div class="producto-total"
                                    style="text-align: right; flex: 1; font-weight: bold; font-size: 1.2em;">
                                    $<%= Number(item.subtotal).toLocaleString('es-CO') %>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% if (factura.propina !=null && Number(factura.propina)> 0) { %>
                                <div class="producto-item" style="border-bottom: none;">
                                    <div class="producto-detalles" style="padding-left: 0;">
                                        <div class="producto-nombre"
                                            style="margin: 0; font-weight: bold; font-size: 1.2em; flex: 3;">
                                            Propina</div>
                                        <div class="producto-total"
                                            style="text-align: right; flex: 1; font-weight: bold; font-size: 1.2em;">$
                                            <%= Number(factura.propina).toLocaleString('es-CO') %>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                                    <% if (factura.total_impuestos != null && Number(factura.total_impuestos) > 0) { %>
                                        <div class="small" style="text-align: right; margin-top: 8px;">
                                            <div>Subtotal: $<%= Number(factura.subtotal || 0).toLocaleString('es-CO') %></div>
                                            <div>Impuestos: $<%= Number(factura.total_impuestos).toLocaleString('es-CO') %></div>
                                        </div>
                                        <% } %>
                                            <div class="total-final" style="font-size: 1.4em;">
                                                Total: $<%= Number(factura.total).toLocaleString('es-CO') %>
                                            </div>
                                            <% if (factura.efectivo_recibido != null && Number(factura.efectivo_recibido) > Number(factura.total)) { %>
                                                <div class="small" style="text-align: right; margin-top: 6px;">
                                                    <div>Recibido: $<%= Number(factura.efectivo_recibido).toLocaleString('es-CO') %></div>
                                                    <div>Cambio: $<%= (Number(factura.efectivo_recibido) - Number(factura.total)).toLocaleString('es-CO') %></div>
                                                </div>
                                            <% } %>
                </div>

                <div class="divider"></div>

                <div class="text-center small">
                    <div><strong>Forma de Pago:</strong>
                        <%= factura.forma_pago.charAt(0).toUpperCase() + factura.forma_pago.slice(1) %>
                    </div>
                    <% if (factura.forma_pago === 'mixto') { %>
                        <div style="margin-top: 5px; font-size: 0.9em; text-align: left; display: inline-block;">
                            <% if (Number(factura.monto_efectivo) > 0) { %>
                                <div><i class="bi bi-cash"></i> Efectivo: $<%= Number(factura.monto_efectivo).toLocaleString('es-CO') %></div>
                            <% } %>
                            <% if (Number(factura.monto_transferencia) > 0) { %>
                                <div><i class="bi bi-bank"></i> Transf.: $<%= Number(factura.monto_transferencia).toLocaleString('es-CO') %></div>
                            <% } %>
                        </div>
                    <% } %>
                    <div id="previewQrContainer" class="mt-3 mb-3" style="<%= config.qr_src ? '' : 'display:none' %>">
                        <img id="previewQrImg" src="<%= config.qr_src || '' %>" alt="QR para transferencia" style="max-width: 150px;">
                    </div>
                            <div class="mt-2">
                                <%= config.pie_pagina || '¡Gracias por su compra!' %>
                            </div>
                </div>
    </div>
    <script src="/js/modulos/facturas-impresion.js"></script>
</body>

</html>