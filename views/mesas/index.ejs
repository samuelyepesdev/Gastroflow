<%- include('../partials/layout/head', { titulo: 'Mesas' }) %>
    <link rel="stylesheet" href="/css/modulos/mesas.css?v=<%= assetV %>">
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null, tenant: typeof tenant
        !=='undefined' ? tenant : null }) %>

        <% if (typeof avisoCajaCerrada !=='undefined' && avisoCajaCerrada) { %>
            <div class="alert alert-warning alert-dismissible fade show rounded-0 mb-0 text-center py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                No tienes un turno de caja abierto — las ventas de hoy no quedarán incluidas en ningún arqueo.
                <% if (user && user.permisos && user.permisos.includes('caja.abrir_cerrar')) { %>
                    <a href="/caja" class="alert-link">Abrir caja</a>
                <% } %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
            <% } %>

                <div class="container py-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 mb-4">
                <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-grid text-primary me-2"></i>Mesas</h4>
                
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <% if (user.rol !=='mesero' && user.rol !=='cajero' ) { %>
                        <button id="btnCrearMasivas" class="btn btn-success fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i>Crear Múltiples Mesas
                        </button>
                        <button id="btnNuevaMesa" class="btn btn-primary fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i>Nueva Mesa
                        </button>
                        <% if (user.rol === 'superadmin' || (user.permisos && user.permisos.includes('mesas.qr'))) { %>
                        <div class="dropdown">
                            <button class="btn btn-outline-dark fw-semibold dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-qr-code-scan me-1"></i> Menú QR
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><a class="dropdown-item" href="#" id="btnGenerarQRs"><i class="bi bi-magic text-primary me-2"></i>Generar Tokens Faltantes</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/mesas/qrs/imprimir" target="_blank"><i class="bi bi-printer text-success me-2"></i>Imprimir QRs</a></li>
                            </ul>
                        </div>
                        <% } %>
                    <% } %>
                </div>
            </div>

            <!-- Sección de Mesas Virtuales (pedidos para llevar / domicilios enviados desde el POS) -->
            <% if (typeof mesasVirtuales !=='undefined' && mesasVirtuales.length > 0) { %>
                <div class="mb-5">
                    <h5 class="mb-3 text-primary fw-bold"><i class="bi bi-bag-check me-2"></i>Pedidos para Llevar / Domicilios</h5>
                    <%- include('_grid', { mesas: mesasVirtuales }) %>
                    <hr class="my-4">
                </div>
            <% } %>

            <!-- Atención en Salón -->
            <div class="mb-4">
                <h5 class="mb-3 fw-bold text-secondary">Atención en Salón</h5>
                <%- include('_grid', { mesas: mesas }) %>
            </div>
        </div>

        <%- include('_modales') %>

            <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
            
            <!-- Core Modules -->
            <script src="/js/core/money-input.js?v=<%= assetV %>"></script>
            
            <script src="/js/modulos/mesas/mesas_core.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas/mesas_api.js?v=<%= assetV %>"></script>
            <script src="/js/core/combo-picker.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas/mesas_modificadores.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas/mesas_ui.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas/mesas_acciones.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas/mesas_facturacion.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas/mesas_admin.js?v=<%= assetV %>"></script>
            <script src="/js/modulos/mesas-init.js?v=<%= assetV %>"></script>
</body>

</html>