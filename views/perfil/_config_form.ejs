<!-- Columna Personalización -->
<div class="col-lg-7">
    <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-white border-0 pt-4 pb-0">
            <h5 class="card-title mb-0"><i class="bi bi-palette-fill text-primary me-2"></i>Personalización y Datos</h5>
        </div>
        <div class="card-body">
            <form id="perfilForm">
                <h6 class="mb-3 text-muted">Datos de Información</h6>

                <div class="mb-4">
                    <label for="logo" class="form-label d-block text-muted small fw-bold">Imagen Comercial / Logo</label>
                    <div class="d-flex align-items-center gap-3">
                        <% const tcfg=typeof tenant.config==='string' ? JSON.parse(tenant.config) : (tenant.config ||
                            {}); %>
                            <% if (tenant.logo_src) { %>
                                <img src="<%= tenant.logo_src %>" alt="Logo"
                                    class="rounded-circle object-fit-cover shadow-sm border" width="64" height="64"
                                    id="previewLogo">
                                <% } else { %>
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm"
                                        style="width: 64px; height: 64px; font-size: 24px" id="previewLogoPlaceholder">
                                        <%= tenant.nombre.charAt(0).toUpperCase() %>
                                    </div>
                                    <img src="" alt="Logo"
                                        class="rounded-circle object-fit-cover shadow-sm border d-none" width="64"
                                        height="64" id="previewLogo">
                                    <% } %>
                                        <div class="flex-grow-1">
                                            <input class="form-control form-control-sm" type="file" id="logo"
                                                name="logo" accept="image/*" onchange="previewImage(this)">
                                            <small class="text-muted">Formatos JPG o PNG (Recomendado 200x200px)</small>
                                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre Comercial</label>
                    <input type="text" class="form-control" id="nombre" name="nombre" value="<%= tenant.nombre %>"
                        required>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label for="direccion" class="form-label">Dirección / Sucursal</label>
                        <input type="text" class="form-control" id="direccion" name="direccion"
                            value="<%= tenant.direccion || '' %>">
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label for="telefono" class="form-label">Teléfono de Contacto</label>
                        <input type="text" class="form-control" id="telefono" name="telefono"
                            value="<%= tenant.telefono || '' %>">
                    </div>
                    <div class="col-md-4">
                        <label for="email" class="form-label">Correo para Reportes</label>
                        <input type="email" class="form-control" id="email" name="email"
                            value="<%= tenant.email || '' %>" placeholder="ejemplo@correo.com">
                    </div>
                </div>

                <hr class="my-4">

                <h6 class="mb-3 text-muted">Horario de Atención</h6>
                <p class="small text-muted mb-3">Los días que marques como cerrados se excluyen de la alerta
                    automática de "caída de ventas" por correo, para que no te llegue un aviso de -100% un día
                    que simplemente no abres.</p>

                <% const horario = tcfg.horario || {}; const diasAbiertos = Array.isArray(horario.dias_abiertos) ? horario.dias_abiertos : [0, 1, 2, 3, 4, 5, 6]; %>
                <div class="mb-4">
                    <label class="form-label d-block text-muted small fw-bold">Días que abre</label>
                    <div class="d-flex gap-2 flex-wrap" id="diasAbiertosGroup">
                        <% const nombresDias = [
                            { valor: 0, corto: 'Dom' },
                            { valor: 1, corto: 'Lun' },
                            { valor: 2, corto: 'Mar' },
                            { valor: 3, corto: 'Mié' },
                            { valor: 4, corto: 'Jue' },
                            { valor: 5, corto: 'Vie' },
                            { valor: 6, corto: 'Sáb' }
                        ]; %>
                        <% nombresDias.forEach(d => { %>
                            <button type="button"
                                class="btn btn-sm dia-toggle <%= diasAbiertos.includes(d.valor) ? 'btn-primary' : 'btn-outline-secondary' %>"
                                data-dia="<%= d.valor %>" onclick="toggleDia(this)"><%= d.corto %></button>
                        <% }) %>
                    </div>
                </div>

                <% const tipoJornada = horario.tipo_jornada === 'partida' ? 'partida' : 'unica'; %>
                <div class="mb-3">
                    <label class="form-label d-block text-muted small fw-bold">Tipo de jornada</label>
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="tipoJornada" id="jornadaUnica" value="unica"
                            <%= tipoJornada==='unica' ? 'checked' : '' %> onchange="toggleTipoJornada()">
                        <label class="btn btn-outline-primary btn-sm" for="jornadaUnica">Jornada única</label>

                        <input type="radio" class="btn-check" name="tipoJornada" id="jornadaPartida" value="partida"
                            <%= tipoJornada==='partida' ? 'checked' : '' %> onchange="toggleTipoJornada()">
                        <label class="btn btn-outline-primary btn-sm" for="jornadaPartida">Partida (mañana y
                            tarde)</label>
                    </div>
                    <p class="small text-muted mt-2 mb-0">Elige "Partida" si el negocio cierra al mediodía y vuelve
                        a abrir más tarde (ej. 8am-2pm y 5pm-10pm).</p>
                </div>

                <div class="row mb-4" id="jornadaUnicaFields" style="<%= tipoJornada==='partida' ? 'display:none' : '' %>">
                    <div class="col-md-4">
                        <label for="horaApertura" class="form-label">Hora de apertura</label>
                        <input type="time" class="form-control" id="horaApertura" name="hora_apertura"
                            value="<%= horario.hora_apertura || '08:00' %>">
                    </div>
                    <div class="col-md-4">
                        <label for="horaCierre" class="form-label">Hora de cierre</label>
                        <input type="time" class="form-control" id="horaCierre" name="hora_cierre"
                            value="<%= horario.hora_cierre || '22:00' %>">
                    </div>
                </div>

                <div class="mb-4" id="jornadaPartidaFields" style="<%= tipoJornada==='unica' ? 'display:none' : '' %>">
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis mb-1">Mañana</span>
                        </div>
                        <div class="col-md-6">
                            <label for="mananaApertura" class="form-label small">Apertura</label>
                            <input type="time" class="form-control" id="mananaApertura" name="manana_apertura"
                                value="<%= horario.manana_apertura || '08:00' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="mananaCierre" class="form-label small">Cierre</label>
                            <input type="time" class="form-control" id="mananaCierre" name="manana_cierre"
                                value="<%= horario.manana_cierre || '14:00' %>">
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis mb-1">Tarde</span>
                        </div>
                        <div class="col-md-6">
                            <label for="tardeApertura" class="form-label small">Apertura</label>
                            <input type="time" class="form-control" id="tardeApertura" name="tarde_apertura"
                                value="<%= horario.tarde_apertura || '17:00' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="tardeCierre" class="form-label small">Cierre</label>
                            <input type="time" class="form-control" id="tardeCierre" name="tarde_cierre"
                                value="<%= horario.tarde_cierre || '22:00' %>">
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <h6 class="mb-3 text-muted">Paleta de Colores (Apariencia)</h6>
                <p class="small text-muted mb-4">Selecciona los colores para personalizar la barra de
                    navegación y los botones principales del sistema de tu negocio.</p>

                <!-- Plantillas Predefinidas -->
                <div class="mb-4">
                    <div class="form-label d-block text-muted small fw-bold">Plantillas Rápidas</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                            onclick="setTemplate({nav: '#16283e', text: '#ffffff', pri: '#ff5a36', sec: '#5b6b7e', cPri: '#16283e', cSec: '#0f766e', mLibre: '#22c55e', mOcupada: '#f59e0b'})">Moderno
                            (Defecto)</button>
                        <button type="button" class="btn btn-sm" style="background:#ffb6b9; color:#fff;"
                            onclick="setTemplate({nav: '#fdf6e3', text: '#333333', pri: '#ffb6b9', sec: '#fae3d9', cPri: '#bbded6', cSec: '#8ac6d1', mLibre: '#a0e8af', mOcupada: '#ffd3b6'})">Pastel
                            Dulce</button>
                        <button type="button" class="btn btn-sm" style="background:#e74c3c; color:#fff;"
                            onclick="setTemplate({nav: '#16283e', text: '#ecf0f1', pri: '#e74c3c', sec: '#95a5a6', cPri: '#34495e', cSec: '#16a085', mLibre: '#27ae60', mOcupada: '#d35400'})">Rojo
                            Oscuro</button>
                        <button type="button" class="btn btn-sm" style="background:#22c55e; color:#fff;"
                            onclick="setTemplate({nav: '#14532d', text: '#ffffff', pri: '#22c55e', sec: '#a8a29e', cPri: '#166534', cSec: '#15803d', mLibre: '#4ade80', mOcupada: '#fb923c'})">Bosque</button>
                        <button type="button" class="btn btn-sm" style="background:#f5ce42; color:#0e1b2c;"
                            onclick="setTemplate({nav: '#0e1b2c', text: '#f5ce42', pri: '#f5ce42', sec: '#333333', cPri: '#2a2a2a', cSec: '#3f3f3f', mLibre: '#a3e635', mOcupada: '#f59e0b'})">Lujo</button>
                    </div>
                </div>

                <% const cfg=typeof tenant.config==='string' ? JSON.parse(tenant.config) : (tenant.config || {}); const
                    colores=cfg.colores || {}; %>

                    <div class="row g-4">
                        <!-- Navbar Background -->
                        <div class="col-md-6">
                            <label for="colorNavbar" class="form-label d-block">Barra Superior (Fondo)</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorNavbar"
                                    title="Elegir color" value="<%= colores.navbar || '#16283e' %>">
                                <span class="small text-muted">El fondo del menú donde tienes las distintas
                                    páginas.</span>
                            </div>
                        </div>

                        <!-- Navbar Text -->
                        <div class="col-md-6">
                            <label for="colorNavbarText" class="form-label d-block">Barra Superior (Texto)</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorNavbarText"
                                    title="Elegir color" value="<%= colores.navbarText || '#ffffff' %>">
                                <span class="small text-muted">El color de las letras del menú superior para asegurar
                                    contraste.</span>
                            </div>
                        </div>

                        <!-- Botones Principales -->
                        <div class="col-md-6">
                            <label for="colorPrimary" class="form-label d-block">Botones Principales (Links)</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorPrimary"
                                    title="Elegir color" value="<%= colores.primary || '#ff5a36' %>">
                                <span class="small text-muted">Color para el botón de "Guardar", links activos y
                                    destaques.</span>
                            </div>
                        </div>

                        <!-- Botones Secundarios -->
                        <div class="col-md-6">
                            <label for="colorSecondary" class="form-label d-block">Botones Secundarios</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorSecondary"
                                    title="Elegir color" value="<%= colores.secondary || '#5b6b7e' %>">
                                <span class="small text-muted">Color para botones como "Cancelar" o "Limpiar".</span>
                            </div>
                        </div>

                        <!-- Tarjetas Dashboard Principales -->
                        <div class="col-md-6">
                            <label for="colorCardPrimary" class="form-label d-block">Tarjetas Dashboard (Primario)</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorCardPrimary"
                                    title="Elegir color" value="<%= colores.cardPrimary || '#16283e' %>">
                                <span class="small text-muted">Color base para tarjetas de ingresos y métricas
                                    globales.</span>
                            </div>
                        </div>

                        <!-- Tarjetas Dashboard Secundarias -->
                        <div class="col-md-6">
                            <label for="colorCardSecondary" class="form-label d-block">Tarjetas Dashboard (Secundario)</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorCardSecondary"
                                    title="Elegir color" value="<%= colores.cardSecondary || '#0f766e' %>">
                                <span class="small text-muted">Color para tarjetas de cantidades y números de
                                    operaciones.</span>
                            </div>
                        </div>

                        <!-- Mesa Libre -->
                        <div class="col-md-6">
                            <label for="colorMesaLibre" class="form-label d-block">Mesas Libres y Opciones</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorMesaLibre"
                                    title="Elegir color mesa libre" value="<%= colores.mesaLibre || '#22c55e' %>">
                                <span class="small text-muted">Color de estado e indicativo para las mesas u operaciones
                                    sin usar.</span>
                            </div>
                        </div>

                        <!-- Mesa Ocupada -->
                        <div class="col-md-6">
                            <label for="colorMesaOcupada" class="form-label d-block">Mesas Ocupadas</label>
                            <div class="d-flex align-items-center">
                                <input type="color" class="form-control form-control-color me-2" id="colorMesaOcupada"
                                    title="Elegir color mesa ocupada" value="<%= colores.mesaOcupada || '#f59e0b' %>">
                                <span class="small text-muted">Color de estado en uso o bloqueadas en el panel.</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-5">
                        <button type="submit" class="btn btn-primary px-4 py-2" id="btnGuardar">
                            <i class="bi bi-save me-2"></i>Guardar Cambios
                        </button>
                    </div>
            </form>
        </div>
    </div>
</div>