<%- include('../partials/layout/head', { titulo: 'Configuración de Impresión' }) %>
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null, tenant: typeof tenant
        !=='undefined' ? tenant : null }) %>

        <div class="container mt-4">
            <h2 class="mb-4"><i class="bi bi-gear me-2"></i>Configuración de Factura</h2>

            <form action="/configuracion" method="POST" enctype="multipart/form-data">
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="bi bi-building me-2"></i>Datos del Negocio
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="nombre_negocio" class="form-label">Nombre del Negocio</label>
                                <input type="text" class="form-control" id="nombre_negocio" name="nombre_negocio"
                                    value="<%= config.nombre_negocio || '' %>" required>
                            </div>
                            <div class="col-md-6">
                                <label for="nit" class="form-label">NIT/RUT</label>
                                <input type="text" class="form-control" id="nit" name="nit" value="<%= config.nit || '' %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="direccion" class="form-label">Dirección</label>
                                <input type="text" class="form-control" id="direccion" name="direccion"
                                    value="<%= config.direccion || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label for="telefono" class="form-label">Teléfono</label>
                                <input type="text" class="form-control" id="telefono" name="telefono"
                                    value="<%= config.telefono || '' %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="logo" class="form-label">Logo del Negocio</label>
                                <input type="file" class="form-control" id="logo" name="logo" accept="image/*">
                                <% if (config.logo_src) { %>
                                    <img src="<%= config.logo_src %>" alt="Logo actual" class="mt-2"
                                        style="max-width: 200px;">
                                    <% } %>
                            </div>
                            <div class="col-md-6">
                                <label for="qr" class="form-label">QR para Transferencias</label>
                                <input type="file" class="form-control" id="qr" name="qr" accept="image/*">
                                <% if (config.qr_src) { %>
                                    <img src="<%= config.qr_src %>" alt="QR actual" class="mt-2"
                                        style="max-width: 150px;">
                                    <% } %>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="pie_pagina" class="form-label">Pie de Página</label>
                                <textarea class="form-control" id="pie_pagina" name="pie_pagina"
                                    rows="3"><%= config.pie_pagina || '' %></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="bi bi-printer me-2"></i>Formato de Impresión
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="ancho_papel" class="form-label">Ancho del Papel (mm)</label>
                                <input type="number" class="form-control" id="ancho_papel" name="ancho_papel"
                                    value="<%= config.ancho_papel || 80 %>" min="58" max="80">
                                <small class="text-muted">Recomendado: 80mm para facturas estándar</small>
                            </div>
                            <div class="col-md-6">
                                <label for="font_size" class="form-label">Tamaño de Fuente</label>
                                <select class="form-control" id="font_size" name="font_size">
                                    <option value="1" <%=(config.font_size || 1)==1 ? 'selected' : '' %>>Normal</option>
                                    <option value="2" <%=(config.font_size || 1)==2 ? 'selected' : '' %>>Grande</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="bi bi-printer-fill me-2"></i>Impresora / QZ Tray (impresión térmica y cajón)
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">
                            Para imprimir directo a una impresora térmica y abrir el cajón de dinero al
                            facturar, instala <a href="https://qz.io/download/" target="_blank" rel="noopener noreferrer">QZ Tray</a>
                            (gratis) en la PC de este negocio y actívalo aquí.
                        </p>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="qzHabilitado"
                                name="qz_habilitado" <%= config.qz_habilitado ? 'checked' : '' %>>
                            <label class="form-check-label" for="qzHabilitado">Usar QZ Tray</label>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label for="qzImpresoraSelect" class="form-label">Impresora</label>
                                <div class="input-group">
                                    <select class="form-control" id="qzImpresoraSelect"></select>
                                    <button type="button" class="btn btn-outline-secondary" id="qzBtnDetectar">
                                        <i class="bi bi-search me-1"></i>Detectar impresoras
                                    </button>
                                </div>
                                <input type="text" class="form-control mt-2" id="qzImpresoraNombre" name="impresora_nombre"
                                    value="<%= config.impresora_nombre || '' %>"
                                    placeholder="O escribe el nombre exacto de la impresora">
                                <small class="text-muted">"Detectar impresoras" solo funciona si abres esta página
                                    en la misma PC donde corre QZ Tray.</small>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="imprimirAuto"
                                        name="imprimir_auto" <%= config.imprimir_auto !== 0 ? 'checked' : '' %>>
                                    <label class="form-check-label" for="imprimirAuto">Imprimir recibo automático al vender</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="abrirCajonAuto"
                                        name="abrir_cajon_auto" <%= config.abrir_cajon_auto !== 0 ? 'checked' : '' %>>
                                    <label class="form-check-label" for="abrirCajonAuto">Abrir cajón automático al vender</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="cajon_comando_hex" class="form-label">Comando de apertura de cajón (avanzado)</label>
                                <input type="text" class="form-control" id="cajon_comando_hex" name="cajon_comando_hex"
                                    value="<%= config.cajon_comando_hex || '' %>" placeholder="1B 70 00 19 FA (estándar)">
                                <small class="text-muted">Déjalo vacío salvo que tu cajón use un comando ESC/POS distinto al estándar.</small>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="qzBtnProbar">
                            <i class="bi bi-vibrate me-1"></i>Probar impresión / cajón
                        </button>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Guardar Configuración
                    </button>
                    <button type="button" class="btn btn-info" id="btnPreviewFactura">
                        <i class="bi bi-eye me-1"></i>Vista Previa de Factura
                    </button>
                    <a href="/" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </form>

            <div class="card mb-4" id="cardBrochure">
                <div class="card-header">
                    <i class="bi bi-images me-2"></i>Carta / Brochure del Menú Digital
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Sube la carta de tu restaurante (imágenes JPG, PNG, WebP o PDF, máximo 10&nbsp;MB cada una y
                        20 páginas). Tus clientes la verán como carrusel con el botón <strong>Ver carta</strong> en el
                        menú QR, además del menú normal.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <input type="file" id="brochureInput" class="d-none" multiple
                            accept="image/jpeg,image/png,image/webp,application/pdf">
                        <button type="button" class="btn btn-primary" id="btnBrochureSubir">
                            <i class="bi bi-upload me-1"></i>Subir páginas
                        </button>
                    </div>
                    <div id="brochureLista" class="row g-3">
                        <div class="col-12 text-muted small">Cargando…</div>
                    </div>
                    <div id="brochureFeedback" class="alert mt-3 mb-0" hidden></div>
                </div>
            </div>

            <% if (typeof nav !=='undefined' && nav.can.alertas) { %>
                <div class="card mb-4" id="cardAlertas">
                    <div class="card-header">
                        <i class="bi bi-bell me-2"></i>Alertas Proactivas por Email
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">
                            Recibe un correo automático cuando: haya insumos en o por debajo del stock mínimo,
                            las ventas del día bajen mucho respecto al promedio reciente, o una mesa lleve
                            abierta demasiado tiempo sin facturar.
                        </p>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="alertasActivas"
                                <%= alertasConfig.alertas_activas ? 'checked' : '' %>>
                            <label class="form-check-label" for="alertasActivas">Activar alertas proactivas</label>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="alertasEmail" class="form-label">Correo de notificación</label>
                                <input type="email" class="form-control" id="alertasEmail"
                                    value="<%= alertasConfig.email_notificacion || '' %>"
                                    placeholder="<%= tenant && tenant.email ? tenant.email : 'correo@negocio.com' %>">
                                <small class="text-muted">Si lo dejas vacío se usa el correo del negocio.</small>
                            </div>
                            <div class="col-md-3">
                                <label for="alertasUmbralHorasMesa" class="form-label">Mesa sin facturar (horas)</label>
                                <input type="number" class="form-control" id="alertasUmbralHorasMesa" min="1" max="24"
                                    value="<%= alertasConfig.umbral_horas_mesa %>">
                            </div>
                            <div class="col-md-3">
                                <label for="alertasUmbralVentas" class="form-label">Caída de ventas (%)</label>
                                <input type="number" class="form-control" id="alertasUmbralVentas" min="1" max="100"
                                    value="<%= alertasConfig.umbral_caida_ventas_pct %>">
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary" id="btnGuardarAlertas">
                            <i class="bi bi-save me-1"></i>Guardar Alertas
                        </button>
                        <div id="alertasFeedback" class="alert mt-3 mb-0" hidden></div>
                    </div>
                </div>
                <% } %>
        </div>

        <!-- Modal para vista previa de factura -->
        <div class="modal fade" id="modalPreviewFactura" tabindex="-1">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-eye me-2"></i>Vista Previa de Factura
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe id="iframePreview" style="width: 100%; height: 600px; border: none;"></iframe>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/layout/scripts', { jquery: true }) %>
        <script src="/js/vendor/qz-tray.js?v=<%= assetV %>"></script>
        <script src="/js/modulos/configuracion.js?v=<%= assetV %>"></script>
        <script src="/js/modulos/configuracion_qz.js?v=<%= assetV %>"></script>
        <script src="/js/modulos/configuracion_alertas.js?v=<%= assetV %>"></script>
        <script src="/js/modulos/configuracion_brochure.js?v=<%= assetV %>"></script>
</body>

</html>