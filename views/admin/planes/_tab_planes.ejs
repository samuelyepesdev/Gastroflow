<div class="tab-pane fade" id="tabP">
    <p class="text-muted small mb-3">Ajusta los precios de cada plan segun el tamano del negocio.</p>
    <div class="row g-4">
        <% for (var pi=0; pi < (plans ? plans.length : 0); pi++) { var p=plans[pi]; %>
            <% var pGrad=p.slug==='pro' ? 'linear-gradient(135deg,#ff5a36,#e8431f)' : p.slug==='premium'
                ? 'linear-gradient(135deg,#ff5a36,#e8431f)' : 'linear-gradient(135deg,#5b6b7e,#46566a)' ; %>
                <div class="col-md-4">
                    <div class="plan-card">
                        <div class="plan-hdr" style="background:<%= pGrad %>">
                            <input type="text" class="plan-title-input mb-1" id="pn-<%= p.id %>" value="<%= p.nombre %>"
                                style="background:transparent; border:none; color:white; font-weight:bold; font-size:1.25rem; width:100%; border-bottom: 1px dashed rgba(255,255,255,0.3);">
                            <textarea class="plan-desc-input" id="pd-<%= p.id %>" rows="2"
                                style="background:transparent; border:none; color:rgba(255,255,255,0.9); font-size:0.85rem; width:100%; resize:none;"><%= p.descripcion %></textarea>
                        </div>
                        <div class="plan-body">
                            <div class="mb-3">
                                <label for="pdd-<%= p.id %>" class="small text-muted fw-bold">Descripción Detallada (PDF)</label>
                                <textarea class="form-control form-control-sm" id="pdd-<%= p.id %>" rows="3"
                                    style="font-size: 0.75rem;"><%= p.descripcion_detallada %></textarea>
                            </div>
                            <div class="mb-2">
                                <div class="small text-muted fw-bold">Características incluidas</div>
                                <label class="feat-check-item fw-bold" for="pc-<%= p.id %>-todos"
                                    title="Incluye todos los módulos actuales y los que se agreguen después. Los administradores de este plan reciben cada módulo nuevo sin tocar el plan.">
                                    <input type="checkbox" id="pc-<%= p.id %>-todos" data-plan-module="*"
                                        <%= p.caracteristicas && p.caracteristicas.includes('*') ? 'checked' : '' %>>
                                    Todos los módulos (incluidos los nuevos)
                                </label>
                                <div class="feat-check-grid">
                                    <% for (var mi=0; mi < (planModules ? planModules.length : 0); mi++) {
                                        var modSlug = planModules[mi];
                                        var modLabel = (moduleLabels && moduleLabels[modSlug]) || modSlug;
                                        var checked = p.caracteristicas && p.caracteristicas.includes(modSlug);
                                    %>
                                        <label class="feat-check-item" for="pc-<%= p.id %>-<%= modSlug %>">
                                            <input type="checkbox" id="pc-<%= p.id %>-<%= modSlug %>"
                                                data-plan-module="<%= modSlug %>" <%= checked ? 'checked' : '' %>>
                                            <%= modLabel %>
                                        </label>
                                        <% } %>
                                </div>
                            </div>
                            <div class="section-lbl">Precio mensual por tamaño</div>
                            <div class="price-row"><label for="pp-<%= p.id %>-pequeno">Pequeño</label><input type="text" inputmode="decimal" class="price-input money-input"
                                    id="pp-<%= p.id %>-pequeno" value="<%= Number(p.precio_pequeno || 0).toLocaleString('es-CO') %>">
                            </div>
                            <div class="price-row"><label for="pp-<%= p.id %>-mediano">Mediano</label><input type="text" inputmode="decimal" class="price-input money-input"
                                    id="pp-<%= p.id %>-mediano" value="<%= Number(p.precio_mediano || 0).toLocaleString('es-CO') %>">
                            </div>
                            <div class="price-row"><label for="pp-<%= p.id %>-grande">Grande</label> <input type="text" inputmode="decimal" class="price-input money-input"
                                    id="pp-<%= p.id %>-grande" value="<%= Number(p.precio_grande || 0).toLocaleString('es-CO') %>"></div>
                            <button class="btn-savep mt-2" onclick="savePlanCompleto(<%= p.id %>)">
                                <i class="bi bi-floppy me-1"></i>Guardar Cambios
                            </button>
                        </div>
                    </div>
                </div>
                <% } %>
    </div>
</div>