<!-- Modal Crear Restaurante (Diseño Limpio) -->
<div class="modal fade" id="modalCreateTenant" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form action="/admin/tenants" method="POST">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Nuevo Establacimiento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="createTenantNombre" class="form-label">Nombre del Restaurante</label>
                            <input id="createTenantNombre" name="nombre" class="form-control" placeholder="Ej: Pizzería Roma" required>
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantSlug" class="form-label">Slug de acceso</label>
                            <input id="createTenantSlug" name="slug" class="form-control" placeholder="pizzeria-roma" required>
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantNit" class="form-label">NIT / Documento</label>
                            <input id="createTenantNit" name="nit" class="form-control" placeholder="NIT o Cédula">
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantCiudad" class="form-label">Ciudad</label>
                            <input id="createTenantCiudad" name="ciudad" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantEmail" class="form-label">Correo Electrónico (Reportes)</label>
                            <input type="email" id="createTenantEmail" name="email" class="form-control" placeholder="admin@restaurante.com">
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantTipoNegocio" class="form-label">Tipo de Negocio</label>
                            <select id="createTenantTipoNegocio" name="config[tipo_negocio]" class="form-select">
                                <option value="restaurante">🍴 Restaurante</option>
                                <option value="comidas_rapidas">🍔 Comidas Rápidas</option>
                                <option value="panaderia">🥯 Panadería / Repostería</option>
                                <option value="pasteleria">🍰 Pastelería Profesional</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantColor" class="form-label">Color Corporativo</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" id="createTenantColor" name="config[colors][primary]"
                                    class="form-control form-control-color"
                                    style="width: 45px; height: 38px; padding: 2px;" value="#ff5a36">
                                <span class="small text-muted">Este color se usará para el Navbar y
                                    botones.</span>
                            </div>
                        </div>
                        <input type="hidden" name="plan_id" value="1">
                        <hr>
                        <h6 class="fw-bold mt-2">Usuario Administrador del Local</h6>
                        <div class="col-md-6">
                            <label for="createTenantAdminNombre" class="form-label">Nombre del Administrador</label>
                            <input id="createTenantAdminNombre" name="admin_nombre_completo" class="form-control" placeholder="Nombre completo">
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantAdminEmail" class="form-label">Correo del Administrador</label>
                            <input id="createTenantAdminEmail" name="admin_email" type="email" class="form-control" placeholder="admin@correo.com">
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantAdminUsername" class="form-label">Nombre de Usuario (Login)</label>
                            <input id="createTenantAdminUsername" name="admin_username" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label for="createTenantAdminPassword" class="form-label">Contraseña inicial</label>
                            <input id="createTenantAdminPassword" name="admin_password" type="password" class="form-control" required minlength="6">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary px-4">Crear Restaurante</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Añadir Usuario -->
<div class="modal fade" id="modalCreateUser" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/admin/tenants/<%= selectedTenant ? selectedTenant.id : '' %>/users" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Añadir Colaborador</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="createUserUsername" class="form-label">Username</label>
                        <input id="createUserUsername" name="username" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="createUserEmail" class="form-label">Correo Electrónico (Reportes)</label>
                        <input id="createUserEmail" name="email" type="email" class="form-control" placeholder="usuario@correo.com">
                    </div>
                    <div class="mb-3">
                        <label for="createUserPassword" class="form-label">Contraseña</label>
                        <input id="createUserPassword" name="password" type="password" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <div class="form-label">Roles (puedes marcar más de uno)</div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rol_nombres[]" value="mesero" id="createRolMesero" checked>
                            <label class="form-check-label" for="createRolMesero">Mesero</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rol_nombres[]" value="cajero" id="createRolCajero">
                            <label class="form-check-label" for="createRolCajero">Cajero</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rol_nombres[]" value="cocinero" id="createRolCocinero">
                            <label class="form-check-label" for="createRolCocinero">Cocinero</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rol_nombres[]" value="admin" id="createRolAdmin">
                            <label class="form-check-label" for="createRolAdmin">Administrador</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Crear Acceso</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Password Reset -->
<div class="modal fade" id="modalCambiarPassword" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Resetear Contraseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalPasswordUserId">
                <input type="hidden" id="modalPasswordTenantId">
                <div class="mb-3">
                    <label for="modalPasswordNew" class="form-label">Nueva Clave para <strong id="modalPasswordUsername"></strong></label>
                    <input type="password" id="modalPasswordNew" class="form-control" placeholder="Nueva contraseña">
                </div>
                <div class="mb-3">
                    <label for="modalPasswordConfirm" class="form-label">Confirmar Clave</label>
                    <input type="password" id="modalPasswordConfirm" class="form-control">
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-primary w-100" id="btnGuardarPassword">Aplicar Cambio</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Correo -->
<div class="modal fade" id="modalEditarCorreo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Actualizar Correo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalCorreoUserId">
                <input type="hidden" id="modalCorreoTenantId">
                <div class="mb-3">
                    <label for="modalCorreoInput" class="form-label">Correo para <strong id="modalCorreoUsername"></strong></label>
                    <input type="email" id="modalCorreoInput" class="form-control" placeholder="usuario@correo.com">
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-primary w-100" id="btnGuardarCorreo">Guardar Correo</button>
            </div>
        </div>
    </div>
</div>