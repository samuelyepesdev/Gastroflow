<%- include('_shell/_open', {
    title: 'Eliminar ventas',
    currentAdminPage: 'ventas',
    pageCss: '/css/admin/ventas.css'
}) %>

    <div class="admin-page-header">
        <h1><i class="bi bi-trash3 me-2" style="color: var(--sa-danger);"></i>Eliminar ventas</h1>
        <p class="mb-0">Acción exclusiva de superadmin. Filtra por restaurante y elimina una factura solo si es necesario. <span style="color: var(--sa-danger); font-weight: 700;">Esta acción no se puede deshacer.</span></p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon"><i class="bi bi-receipt"></i></span>
                <span class="stat-title">Facturas mostradas</span>
            </div>
            <div class="stat-val" id="shownInvoicesCount"><%= (ventas || []).length %></div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon"><i class="bi bi-cash-stack"></i></span>
                <span class="stat-title">Monto mostrado</span>
            </div>
            <%
            let totalVal = (ventas || []).reduce((acc, curr) => acc + Number(curr.total || 0), 0);
            %>
            <div class="stat-val" id="shownTotalAmount">$<%= Math.round(totalVal).toLocaleString('es-CO') %></div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon"><i class="bi bi-shop"></i></span>
                <span class="stat-title">Restaurante</span>
            </div>
            <%
            let activeTenantName = 'Todos';
            if (activeTenantId !== 'all') {
                let selectedTenant = (tenants || []).find(t => Number(t.id) === Number(activeTenantId));
                if (selectedTenant) activeTenantName = selectedTenant.nombre;
            }
            %>
            <div class="stat-val" style="font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-top: 5px;">
                <%= activeTenantName %>
            </div>
        </div>
        <div class="stat-card danger-stat">
            <div class="stat-card-header">
                <span class="stat-icon"><i class="bi bi-trash3"></i></span>
                <span class="stat-title">Eliminadas (sesión)</span>
            </div>
            <div class="stat-val" id="deletedSessionCount">0</div>
        </div>
    </div>

    <!-- Selector de Restaurante y Filtros -->
    <%- include('ventas/_selector', { ...locals, tenants, activeTenantId }) %>

    <!-- Tabla de Ventas -->
    <%- include('ventas/_table', { ...locals, ventas }) %>

    <!-- Modal Modificar Venta -->
    <div class="modal fade" id="modalEditarVenta" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Modificar venta <span id="editVentaNumero"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form id="formEditarVenta">
                    <div class="modal-body">
                        <p class="text-muted small mb-3">Acción exclusiva de superadmin. No modifica los productos de la venta, solo estos datos.</p>
                        <input type="hidden" id="editVentaId">
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="editVentaCliente">Cliente</label>
                            <input type="text" class="form-control" id="editVentaCliente" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="editVentaFormaPago">Forma de pago</label>
                            <select class="form-select" id="editVentaFormaPago" required>
                                <option value="efectivo">Efectivo</option>
                                <option value="transferencia">Transferencia</option>
                                <option value="mixto">Mixto</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-semibold" for="editVentaTotal">Total</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="editVentaTotal" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-semibold" for="editVentaPropina">Propina</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="editVentaPropina">
                            </div>
                        </div>
                        <div class="row d-none" id="editVentaMixtoWrap">
                            <div class="col-6 mb-1">
                                <label class="form-label fw-semibold" for="editVentaEfectivo">Monto en efectivo</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="editVentaEfectivo">
                            </div>
                            <div class="col-6 mb-1">
                                <label class="form-label fw-semibold" for="editVentaTransferencia">Monto en transferencia</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="editVentaTransferencia">
                            </div>
                            <div class="col-12 mb-3">
                                <small id="editVentaMixtoAyuda" class="text-muted"></small>
                            </div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-semibold" for="editVentaFecha">Fecha y hora</label>
                            <input type="datetime-local" class="form-control" id="editVentaFecha" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardarEditVenta">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

<%- include('_shell/_close', {
    extraScripts: '<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><script src="/js/admin/ventas.js"></script>'
}) %>
