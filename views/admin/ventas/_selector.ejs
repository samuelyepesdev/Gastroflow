<%
const getTenantColor = function(name) {
    const colors = {
        'principal': '#ff5a36',
        'ichiban': '#10b981',
        'rollito cinnamon': '#f59e0b',
        'gelatto & arte': '#8b5cf6',
        'carreteritos': '#0ea5e9',
        'callejero': '#f43f5e'
    };
    return colors[name.toLowerCase()] || '#8a97a8';
}
%>

<div class="filter-card">
    <div class="filter-row">
        <!-- Chips de Restaurante -->
        <div class="chips-container">
            <span class="fs-12 fw-bold text-uppercase text-muted me-2" style="letter-spacing: .03em;">Restaurante</span>
            
            <a href="/admin/ventas?tenantId=all" class="btn-chip <%= activeTenantId === 'all' ? 'active' : '' %>">
                <i class="bi bi-grid-fill me-1"></i>Todos
            </a>
            
            <% (tenants || []).forEach(function(t) { %>
                <% let col = getTenantColor(t.nombre); %>
                <a href="/admin/ventas?tenantId=<%= t.id %>" class="btn-chip <%= activeTenantId !== 'all' && Number(activeTenantId) === Number(t.id) ? 'active' : '' %>">
                    <span class="dot-indicator" style="background: <%= col %>;"></span>
                    <%= t.nombre %>
                </a>
            <% }); %>
        </div>

        <!-- Segmentador de Pago y Buscador -->
        <!-- Los filtros se aplican en el servidor (GET) para poder paginar. -->
        <form method="get" action="/admin/ventas" id="formFiltrosVentas" class="d-flex align-items-center gap-3 flex-wrap">
            <input type="hidden" name="tenantId" value="<%= activeTenantId %>">
            <% if (filtros.desde) { %><input type="hidden" name="desde" value="<%= filtros.desde %>"><% } %>
            <% if (filtros.hasta) { %><input type="hidden" name="hasta" value="<%= filtros.hasta %>"><% } %>

            <div class="segmented-control">
                <button type="submit" name="pago" value="" class="<%= !filtros.formaPago ? 'active' : '' %>">Todas</button>
                <button type="submit" name="pago" value="efectivo" class="<%= filtros.formaPago === 'efectivo' ? 'active' : '' %>">Efectivo</button>
                <button type="submit" name="pago" value="transferencia" class="<%= filtros.formaPago === 'transferencia' ? 'active' : '' %>">Transf.</button>
            </div>

            <div class="search-wrapper">
                <i class="bi bi-search text-muted fs-14"></i>
                <input type="search" id="searchFactura" name="q" value="<%= filtros.q || '' %>" placeholder="# factura o cliente..." enterkeyhint="search">
            </div>
        </form>
    </div>
</div>