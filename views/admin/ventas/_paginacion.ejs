<% if (totalPaginas > 1) { %>
    <%
        // Solo se serializan filtros con valor: URLSearchParams convierte null/undefined
        // en el texto "null"/"undefined", que el controller leería como un filtro real.
        const construirUrlPagina = function (n) {
            const params = { page: n, tenantId: activeTenantId };
            if (filtros.desde) params.desde = filtros.desde;
            if (filtros.hasta) params.hasta = filtros.hasta;
            if (filtros.q) params.q = filtros.q;
            if (filtros.formaPago) params.pago = filtros.formaPago;
            return '/admin/ventas?' + new URLSearchParams(params).toString();
        };
        // Ventana de páginas: primera, última y 2 a cada lado de la actual (con "…").
        const paginasVisibles = [];
        for (let i = 1; i <= totalPaginas; i++) {
            if (i === 1 || i === totalPaginas || Math.abs(i - page) <= 2) paginasVisibles.push(i);
        }
        const desdeFila = (page - 1) * 25 + 1;
        const hastaFila = Math.min(page * 25, totalVentas);
    %>
    <nav class="mt-3" aria-label="Paginación de ventas">
        <p class="text-center text-muted small mb-2">
            Mostrando <%= desdeFila %>–<%= hastaFila %> de <%= Number(totalVentas).toLocaleString('es-CO') %>
        </p>
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="<%= construirUrlPagina(Math.max(page - 1, 1)) %>" aria-label="Anterior">&laquo;</a>
            </li>
            <% paginasVisibles.forEach(function (n, idx) { %>
                <% if (idx > 0 && n - paginasVisibles[idx - 1] > 1) { %>
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                <% } %>
                <li class="page-item <%= n === page ? 'active' : '' %>">
                    <a class="page-link" href="<%= construirUrlPagina(n) %>"><%= n %></a>
                </li>
            <% }); %>
            <li class="page-item <%= page >= totalPaginas ? 'disabled' : '' %>">
                <a class="page-link" href="<%= construirUrlPagina(Math.min(page + 1, totalPaginas)) %>" aria-label="Siguiente">&raquo;</a>
            </li>
        </ul>
    </nav>
<% } %>
