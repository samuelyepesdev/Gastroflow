<%- include('../partials/layout/head', { titulo: 'Combos armables - ' + tenant.nombre }) %>
<link rel="stylesheet" href="/css/modulos/combos.css?v=<%= assetV %>">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

    <div class="container py-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold"><i class="bi bi-puzzle me-2 text-primary"></i>Combos armables</h2>
                <p class="text-muted mb-0">
                    Un combo con lo que siempre incluye y, si quieres, lo que el cliente puede elegir
                    (por ejemplo "Elige tu bebida"). Se vende como una sola línea a un precio fijo.
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a class="btn btn-outline-secondary me-1" href="/combos"><i class="bi bi-arrow-left me-1"></i>Combos fijos</a>
                <button class="btn btn-primary" id="btnNuevoCombo">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo combo
                </button>
            </div>
        </div>

        <div class="alert alert-info small" role="note">
            <i class="bi bi-info-circle me-1"></i>
            Mesas, POS y el Menú QR ya ofrecen estos combos. Los combos fijos de la pantalla anterior siguen
            funcionando mientras terminas de pasarte a este.
        </div>

        <% if (combos.length === 0) { %>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">
                    <i class="bi bi-puzzle display-5 text-primary"></i>
                    <h5 class="mt-3 mb-1">Todavía no hay combos armables</h5>
                    <p class="text-muted mb-3">Por ejemplo: hamburguesa + papas + una bebida a elegir.</p>
                    <button class="btn btn-primary" id="btnNuevoComboVacio">
                        <i class="bi bi-plus-lg me-1"></i>Crear mi primer combo
                    </button>
                </div>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Combo</th>
                                    <th>Pasos</th>
                                    <th>Estación</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="combosTbody">
                                <% combos.forEach(function (c) { %>
                                    <tr data-id="<%= c.id %>">
                                        <td>
                                            <div class="fw-medium"><%= c.nombre %></div>
                                            <% if (c.descripcion) { %><div class="small text-muted"><%= c.descripcion %></div><% } %>
                                        </td>
                                        <td><%= c.grupos_count %></td>
                                        <td><%= c.estacion_nombre || 'Sin estación fija' %></td>
                                        <td class="text-end fw-semibold">$<%= Number(c.precio_base).toLocaleString('es-CO') %></td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-outline-primary btn-editar-combo combo-touch" title="Editar" aria-label="Editar <%= c.nombre %>"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger btn-borrar-combo combo-touch" title="Eliminar" aria-label="Eliminar <%= c.nombre %>"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Modal Crear/Editar combo armable (3 pasos: 1 incluye, 2 elecciones del cliente, 3 nombre y precio) -->
    <div class="modal fade" id="modalCombo" tabindex="-1" aria-labelledby="modalComboTitulo" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalComboTitulo">Nuevo combo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <ol class="combo-pasos" aria-label="Pasos para crear el combo">
                    <li class="combo-paso activo" id="indicadorPaso1" aria-current="step">
                        <span class="combo-paso-num">1</span><span class="combo-paso-texto">Qué incluye</span>
                    </li>
                    <li class="combo-paso-linea" aria-hidden="true"></li>
                    <li class="combo-paso" id="indicadorPaso2">
                        <span class="combo-paso-num">2</span><span class="combo-paso-texto">Qué elige el cliente</span>
                    </li>
                    <li class="combo-paso-linea" aria-hidden="true"></li>
                    <li class="combo-paso" id="indicadorPaso3">
                        <span class="combo-paso-num">3</span><span class="combo-paso-texto">Nombre y precio</span>
                    </li>
                </ol>

                <div class="modal-body">
                    <input type="hidden" id="comboId">

                    <!-- PASO 1: lo que siempre incluye -->
                    <section id="comboPaso1">
                        <h6 class="fw-bold mb-1">¿Qué viene siempre en el combo?</h6>
                        <p class="text-muted small mb-3">
                            Busca y toca cada producto para agregarlo (por ejemplo la hamburguesa y las papas).
                            Si todo lo elige el cliente, puedes seguir sin agregar nada.
                        </p>

                        <div class="position-relative mb-3">
                            <label for="comboBuscar" class="visually-hidden">Buscar producto para agregar</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="search" id="comboBuscar" class="form-control" autocomplete="off"
                                    placeholder="Buscar un producto…" aria-controls="comboResultados">
                            </div>
                            <div id="comboResultados" class="list-group shadow-sm position-absolute w-100 combo-resultados d-none"
                                style="z-index: 5" role="listbox" aria-label="Productos"></div>
                        </div>

                        <div id="comboVacio" class="combo-vacio">
                            <i class="bi bi-basket fs-3 d-block mb-1"></i>
                            Aún no has agregado productos.<br>Escribe arriba para buscarlos.
                        </div>
                        <div id="comboComponentes" class="list-group"></div>
                    </section>

                    <!-- PASO 2: lo que el cliente elige -->
                    <section id="comboPaso2" class="d-none">
                        <h6 class="fw-bold mb-1">¿Algo lo elige el cliente?</h6>
                        <p class="text-muted small mb-3">
                            Opcional. Crea una elección por cada cosa que el cliente pueda escoger: la bebida,
                            el acompañante, adicionales… Si no hay nada que elegir, sigue al siguiente paso.
                        </p>
                        <div id="comboElecciones"></div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <button type="button" class="btn btn-outline-primary" id="btnAgregarEleccion">
                                <i class="bi bi-plus-lg me-1"></i>Agregar una elección
                            </button>
                            <span class="small text-muted ms-1">o empieza con:</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-atajo="bebida">Bebida</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-atajo="acompanante">Acompañante</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-atajo="adicional">Adicionales</button>
                        </div>
                        <datalist id="comboProductosLista"></datalist>
                    </section>

                    <!-- PASO 3: nombre y precio -->
                    <section id="comboPaso3" class="d-none">
                        <h6 class="fw-bold mb-1">Ahora ponle nombre y precio</h6>
                        <p class="text-muted small mb-3">Así queda tu combo. Si por separado cuesta más que el precio que pongas, el cliente ahorra.</p>

                        <div class="combo-recap mb-3" id="comboRecap"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label for="comboNombre" class="form-label">Nombre del combo</label>
                                <input type="text" id="comboNombre" class="form-control" maxlength="150"
                                    placeholder="Ej. Combo hamburguesa" autocomplete="off" aria-describedby="errComboNombre">
                                <div class="invalid-feedback" id="errComboNombre"></div>
                            </div>
                            <div class="col-12">
                                <label for="comboPrecio" class="form-label">Precio del combo</label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">$</span>
                                    <input type="number" id="comboPrecio" class="form-control combos-sin-spinner" min="1"
                                        step="1" inputmode="numeric" placeholder="Ej. 25000" aria-describedby="errComboPrecio">
                                    <div class="invalid-feedback" id="errComboPrecio"></div>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-2" id="comboSugeridos" aria-label="Precios sugeridos"></div>
                                <div class="form-text">Las opciones con "cuesta más" se suman a este precio cuando el cliente las escoge.</div>
                            </div>
                        </div>

                        <button class="btn btn-link px-0 mt-3" type="button" data-bs-toggle="collapse"
                            data-bs-target="#comboAvanzado" aria-expanded="false" aria-controls="comboAvanzado">
                            <i class="bi bi-sliders me-1"></i>Opciones avanzadas
                        </button>
                        <div class="collapse" id="comboAvanzado">
                            <div class="row g-3 pt-2">
                                <div class="col-12">
                                    <label for="comboDescripcion" class="form-label">Descripción <span class="text-muted">(opcional)</span></label>
                                    <input type="text" id="comboDescripcion" class="form-control" maxlength="255" autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label for="comboImpuesto" class="form-label">Impuesto</label>
                                    <select id="comboImpuesto" class="form-select">
                                        <option value="">El del restaurante</option>
                                        <option value="iva_19">IVA 19%</option>
                                        <option value="iva_5">IVA 5%</option>
                                        <option value="impoconsumo_8">Impoconsumo 8%</option>
                                        <option value="exento">Exento</option>
                                        <option value="excluido">Excluido</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="comboEstacion" class="form-label">Estación de cocina</label>
                                    <select id="comboEstacion" class="form-select" aria-describedby="ayudaComboEstacion">
                                        <option value="">Sin estación fija</option>
                                        <% estaciones.forEach(function (e) { %>
                                            <option value="<%= e.id %>"><%= e.nombre %></option>
                                        <% }) %>
                                    </select>
                                    <div class="form-text" id="ayudaComboEstacion">El combo completo llega a esa estación. Sin estación aparece en "Sin estación" del KDS.</div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="text-danger small mt-3 d-none" id="errComboGeneral" role="alert"></div>
                </div>

                <div class="modal-footer justify-content-between flex-wrap gap-2">
                    <div class="combo-resumen" id="comboResumen" aria-live="polite"></div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" id="btnComboCancelar" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-outline-secondary d-none" id="btnComboAtras">
                            <i class="bi bi-arrow-left me-1"></i>Atrás
                        </button>
                        <button type="button" class="btn btn-primary" id="btnComboSiguiente">
                            Siguiente<i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <button type="button" class="btn btn-primary d-none" id="btnGuardarCombo">
                            <i class="bi bi-check-lg me-1"></i>Guardar combo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="combosProductos"><%- jsonSeguro(productos.map(function (p) { return { id: p.id, nombre: p.nombre, codigo: p.codigo, precio: Number(p.precio_unidad) || 0, categoria: p.categoria_nombre || '' }; })) %></script>

    <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
    <script src="/js/modulos/combos-armables.js?v=<%= assetV %>"></script>
</body>

</html>
