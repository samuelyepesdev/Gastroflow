<%- include('../partials/layout/head', { titulo: 'Combos - ' + tenant.nombre }) %>
<link rel="stylesheet" href="/css/modulos/combos.css?v=<%= assetV %>">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

    <div class="container py-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i>Combos</h2>
                <p class="text-muted mb-0">
                    Agrupa varios productos a un precio fijo. Se vende como una sola línea en Mesas, POS y el Menú QR,
                    llega completo a la estación de cocina de su categoría y descuenta el inventario de cada producto
                    que incluye. Las promociones también le aplican.
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a class="btn btn-outline-secondary me-1" href="/combos-armables"><i class="bi bi-puzzle me-1"></i>Combos armables</a>
                <button class="btn btn-primary" id="btnNuevoCombo">
                    <i class="bi bi-plus-lg me-1"></i>Nuevo combo
                </button>
            </div>
        </div>

        <% if (combos.length === 0) { %>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">
                    <i class="bi bi-box-seam display-5 text-primary"></i>
                    <h5 class="mt-3 mb-1">Todavía no has creado ningún combo</h5>
                    <p class="text-muted mb-3">Por ejemplo: hamburguesa + papas + gaseosa a un precio especial.</p>
                    <button class="btn btn-primary" id="btnNuevoComboVacio">
                        <i class="bi bi-plus-lg me-1"></i>Crear mi primer combo
                    </button>
                </div>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Combo</th>
                                    <th>Incluye</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Ahorro del cliente</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="combosTbody">
                                <% combos.forEach(function (c) { %>
                                    <% const ahorro = Number(c.precio_individual) - Number(c.precio_unidad); %>
                                    <tr data-id="<%= c.id %>">
                                        <td>
                                            <div class="fw-medium"><%= c.nombre %></div>
                                            <div class="small text-muted"><%= c.categoria_nombre || 'Sin categoría' %></div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                <% (c.componentes || []).forEach(function (comp) { %>
                                                    <span class="badge rounded-pill text-bg-light border fw-normal">
                                                        <%= comp.cantidad !== 1 ? comp.cantidad + '× ' : '' %><%= comp.nombre %>
                                                    </span>
                                                <% }) %>
                                            </div>
                                        </td>
                                        <td class="text-end fw-semibold">$<%= Number(c.precio_unidad).toLocaleString('es-CO') %></td>
                                        <td class="text-end">
                                            <% if (ahorro > 0) { %>
                                                <span class="badge bg-success-subtle text-success-emphasis">$<%= ahorro.toLocaleString('es-CO') %></span>
                                            <% } else { %>
                                                <span class="text-muted">—</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-outline-primary btn-editar-combo combo-touch" title="Editar" aria-label="Editar <%= c.nombre %>"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger btn-borrar-combo combo-touch" title="Eliminar" aria-label="Eliminar <%= c.nombre %>"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Modal Crear/Editar Combo (2 pasos: 1 productos, 2 nombre y precio) -->
    <div class="modal fade" id="modalCombo" tabindex="-1" aria-labelledby="modalComboTitulo" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalComboTitulo">Nuevo combo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <ol class="combo-pasos" aria-label="Pasos para crear el combo">
                    <li class="combo-paso activo" id="indicadorPaso1" aria-current="step">
                        <span class="combo-paso-num">1</span><span class="combo-paso-texto">Elige los productos</span>
                    </li>
                    <li class="combo-paso-linea" aria-hidden="true"></li>
                    <li class="combo-paso" id="indicadorPaso2">
                        <span class="combo-paso-num">2</span><span class="combo-paso-texto">Nombre y precio</span>
                    </li>
                </ol>

                <div class="modal-body">
                    <input type="hidden" id="comboId">

                    <!-- PASO 1: productos -->
                    <section id="comboPaso1">
                        <h6 class="fw-bold mb-1">¿Qué productos incluye el combo?</h6>
                        <p class="text-muted small mb-3">Busca y toca cada producto para agregarlo. Si va más de uno (por ejemplo 2 gaseosas), súbele la cantidad.</p>

                        <div class="position-relative mb-3">
                            <label for="comboBuscar" class="visually-hidden">Buscar producto para agregar</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="search" id="comboBuscar" class="form-control" autocomplete="off"
                                    placeholder="Buscar un producto…" aria-controls="comboResultados">
                            </div>
                            <div id="comboResultados" class="list-group shadow-sm position-absolute w-100 combo-resultados d-none"
                                style="z-index: 5" role="listbox" aria-label="Productos"></div>
                        </div>

                        <div id="comboVacio" class="combo-vacio">
                            <i class="bi bi-basket fs-3 d-block mb-1"></i>
                            Aún no has agregado productos.<br>Escribe arriba para buscarlos.
                        </div>
                        <div id="comboComponentes" class="list-group"></div>
                        <div class="text-danger small mt-2 d-none" id="errComboComponentes" role="alert"></div>
                    </section>

                    <!-- PASO 2: nombre, precio, categoría -->
                    <section id="comboPaso2" class="d-none">
                        <h6 class="fw-bold mb-1">Ahora ponle nombre y precio</h6>
                        <p class="text-muted small mb-3">Estos son los productos del combo. Si por separado cuestan más que el precio que pongas, el cliente ahorra.</p>

                        <div class="combo-recap mb-3" id="comboRecap"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label for="comboNombre" class="form-label">Nombre del combo</label>
                                <input type="text" id="comboNombre" class="form-control" maxlength="100"
                                    placeholder="Ej. Combo hamburguesa" aria-describedby="errComboNombre" autocomplete="off">
                                <div class="invalid-feedback" id="errComboNombre"></div>
                            </div>
                            <div class="col-md-6">
                                <label for="comboPrecio" class="form-label">Precio del combo</label>
                                <div class="input-group has-validation">
                                    <span class="input-group-text">$</span>
                                    <input type="number" id="comboPrecio" class="form-control combos-sin-spinner" min="1"
                                        step="1" inputmode="numeric" placeholder="Ej. 25000" aria-describedby="errComboPrecio">
                                    <div class="invalid-feedback" id="errComboPrecio"></div>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-2" id="comboSugeridos" aria-label="Precios sugeridos"></div>
                            </div>
                            <div class="col-md-6">
                                <label for="comboCategoria" class="form-label">Categoría</label>
                                <select id="comboCategoria" class="form-select" aria-describedby="ayudaComboCategoria errComboCategoria">
                                    <option value="">Seleccionar…</option>
                                    <% categorias.forEach(function (c) { %>
                                        <option value="<%= c.id %>"><%= c.nombre %></option>
                                    <% }) %>
                                </select>
                                <div class="invalid-feedback" id="errComboCategoria"></div>
                                <div class="form-text" id="ayudaComboCategoria">Define a qué estación de cocina llega el combo.</div>
                            </div>
                        </div>
                        <div class="text-danger small mt-3 d-none" id="errComboGeneral" role="alert"></div>
                    </section>
                </div>

                <div class="modal-footer justify-content-between flex-wrap gap-2">
                    <div class="combo-resumen" id="comboResumen" aria-live="polite"></div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" id="btnComboCancelar" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-outline-secondary d-none" id="btnComboAtras">
                            <i class="bi bi-arrow-left me-1"></i>Atrás
                        </button>
                        <button type="button" class="btn btn-primary" id="btnComboSiguiente">
                            Siguiente<i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <button type="button" class="btn btn-primary d-none" id="btnGuardarCombo">
                            <i class="bi bi-check-lg me-1"></i>Guardar combo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="combosProductos"><%- jsonSeguro(productos.map(function (p) { return { id: p.id, nombre: p.nombre, codigo: p.codigo, precio: Number(p.precio_unidad) || 0, categoria: p.categoria_nombre || '', categoriaId: p.categoria_id || null }; })) %></script>

    <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
    <script src="/js/modulos/combos.js?v=<%= assetV %>"></script>
</body>

</html>
