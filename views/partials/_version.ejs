<%
    // Versión de package.json (res.locals.version en app.js)
    const systemVersion = 'v' + (typeof version !== 'undefined' ? version : '1.0.0');
%>
<div class="system-version-footer text-center py-2" style="font-size: 0.75rem; color: #8a97a8; opacity: 0.8; user-select: none;">
    <span class="fw-medium">Sistema de Facturación</span> 
    <span class="mx-1">•</span> 
    <span class="badge rounded-pill bg-light text-dark border-1 border-slate-200" style="font-size: 0.65rem; border: 1px solid #e4dccf;">
        <%= systemVersion %>
    </span>
    <span class="mx-1">•</span>
    <span>SOPORTE 24/7</span>
</div>
