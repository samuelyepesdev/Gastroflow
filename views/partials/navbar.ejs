<link rel="stylesheet" href="/css/core/navbar.css?v=<%= assetV %>">
<link rel="stylesheet" href="/css/core/tablas-responsive.css?v=<%= assetV %>">
<script src="/js/core/gf.js?v=<%= assetV %>"></script>
<link rel="stylesheet" href="/css/core/gf-marca.css?v=<%= assetV %>">
<script src="/js/core/gf-marca.js?v=<%= assetV %>"></script>
<script src="/js/core/tablas-responsive.js?v=<%= assetV %>" defer></script>
<script src="/js/core/navbar-grupos.js?v=<%= assetV %>" defer></script>
<%- include('_navbar_styles') %>
<link rel="stylesheet" href="/css/core/anuncio-modal.css?v=<%= assetV %>">
<script src="/js/core/anuncios.js?v=<%= assetV %>" defer></script>
<script defer>document.addEventListener('DOMContentLoaded', function () { if (window.GFAnuncios) window.GFAnuncios.iniciar(); });</script>

    <% if (typeof contextoSucursal !== 'undefined' && contextoSucursal) { %>
    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 py-2 px-3 small" style="background:#fef3c7;color:#92400e;border-bottom:1px solid #fde68a;">
        <i class="bi bi-diagram-3"></i>
        <span>Estás administrando la sucursal <strong><%= contextoSucursal.nombre %></strong><% if (contextoSucursal.principalNombre) { %> de <%= contextoSucursal.principalNombre %><% } %>.</span>
        <button type="button" class="btn btn-sm btn-warning js-volver-principal py-0">Volver al principal</button>
    </div>
    <script src="/js/core/sucursal-contexto.js?v=<%= assetV %>" defer></script>
    <% } %>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container-fluid gap-2">

            <a class="navbar-brand" href="<%= nav.brandHref %>" title="<%= nav.tenantNombre %>">
                <img class="n-icon" src="/brand/isotipo/isotipo-oscuro.svg" alt="" width="32" height="32">
                <%= nav.brandName %>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">
                <%- include('_navbar_links') %>

                    <%- include('_navbar_user') %>
            </div>
        </div>
    </nav>