<%#
  Head de las páginas públicas de autenticación/onboarding (login, registro,
  verificar-email, crear-local, pendiente, vincular escritorio): todas comparten
  el CSS base (css/auth/login.css) y bootstrap-icons.
  Uso:
    include('../partials/layout/auth-head', { titulo: (title || 'Iniciar Sesión') + ' | GastroFlow' })
  Opcionales:
    swal: true                        -> agrega SweetAlert2
    seo: { description, canonical }   -> meta description + canonical + theme-color + favicon + analytics
                                          (solo las páginas públicas indexables: login, registro)
    css: ['/css/onboarding/crear-local.css']  -> hojas de estilo propias además de login.css
-%>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <%- include('../_pwa') %>
    <% if (typeof seo !== 'undefined' && seo) { -%>
    <meta name="description" content="<%= seo.description %>">
    <link rel="canonical" href="<%= seo.canonical %>">
    <% } -%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/core/brand.css?v=<%= assetV %>">
    <% if (typeof swal !== 'undefined' && swal) { -%>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <% } -%>
    <link rel="stylesheet" href="/css/auth/login.css?v=<%= assetV %>">
    <% if (typeof css !== 'undefined' && css) { css.forEach(function (hoja) { -%>
    <link rel="stylesheet" href="<%= hoja %>?v=<%= assetV %>">
    <% }) } -%>
    <% if (typeof seo !== 'undefined' && seo) { -%>
    <%- include('../_analytics') %>
    <% } -%>
</head>
