<!DOCTYPE html>
<html lang="es">
<head>
  <% const siteUrl = 'https://gastroflow.digital'; %>
  <% const pageTitle = 'GastroFlow | Gestión Inteligente para Restaurantes'; %>
  <% const pageDesc = 'GastroFlow conecta tus ventas, tu inventario y tu cocina en tiempo real. Fichas técnicas automatizadas, KDS y control total de tu margen.'; %>
  <% const pageImage = siteUrl + '/og-image.png'; %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <link rel="canonical" href="<%= siteUrl %>/">
  <meta name="theme-color" content="<%= settings.color_background || '#080b09' %>">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <!-- Open Graph / Facebook, WhatsApp, LinkedIn -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= siteUrl %>/">
  <meta property="og:site_name" content="GastroFlow">
  <meta property="og:locale" content="es_CO">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="<%= pageImage %>">
  <meta property="og:image:width" content="2400">
  <meta property="og:image:height" content="1260">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="<%= pageImage %>">

  <!-- Structured Data (Google rich results) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "GastroFlow",
    "url": "<%= siteUrl %>/",
    "image": "<%= pageImage %>",
    "description": "<%= pageDesc %>",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "COP",
      "availability": "https://schema.org/InStock"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "GastroFlow",
    "url": "<%= siteUrl %>/",
    "logo": "<%= siteUrl %>/logo.png",
    "description": "<%= pageDesc %>"
  }
  </script>

  <!-- Analytics -->
  <%- include('../partials/_analytics') %>

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <style>
    :root {
      --color-primary: <%= settings.color_primary || '#3fc46d' %>;
      --color-primary-hover: <%= settings.color_primary_hover || '#2e7d46' %>;
      --color-background: <%= settings.color_background || '#080b09' %>;
      --color-text: <%= settings.color_text || '#e9efea' %>;
      --color-accent: <%= settings.color_accent || '#c2604f' %>;
    }
  </style>
  <link rel="stylesheet" href="/css/core/landing.css?v=<%= assetV %>">
  <script>document.documentElement.classList.add('js');</script>
</head>
<body>
  <% const wa = 'https://wa.me/' + settings.whatsapp_number + '?text=' + encodeURIComponent(settings.whatsapp_message); %>
  <% const waPlan = (txt) => 'https://wa.me/' + settings.whatsapp_number + '?text=' + encodeURIComponent(txt); %>
  <% const lista = (txt) => (txt || '').split('\n').filter(f => f.trim()); %>
  <%
    const titulo = settings.hero_title || 'Deja de adivinar. Empieza a controlar tu margen.';
    const resaltado = settings.hero_highlight || '';
    const idx = resaltado ? titulo.indexOf(resaltado) : -1;
  %>

  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="nav">
    <nav class="wrap nav__in" aria-label="Principal">
      <a class="brand" href="#top"><span class="brand__mark"><i class="bi bi-fire" aria-hidden="true"></i></span>GastroFlow</a>
      <div class="nav__links">
        <a id="lnk-nav-funciones" class="nav__link" href="#funciones">Funciones</a>
        <a id="lnk-nav-empezar" class="nav__link" href="#empezar">Cómo empezar</a>
        <a id="lnk-nav-precios" class="nav__link" href="#precios">Planes</a>
      </div>
      <div class="nav__cta">
        <a id="lnk-nav-login" class="btn btn--ghost btn--sm" href="/auth/login">Iniciar sesión</a>
        <a id="lnk-nav-registro" class="btn btn--primary btn--sm" href="/auth/registro">Crear cuenta gratis</a>
      </div>
    </nav>
    <div class="progress" aria-hidden="true"><i id="progreso"></i></div>
  </header>

  <main id="top">
    <span id="contenido"></span>

    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero__grid">
        <div>
          <span class="pill rise" style="--d:0"><span class="pill__dot" aria-hidden="true"></span>Software para restaurantes en Colombia</span>
          <h1 class="hero__title rise" style="--d:1">
            <% if (idx >= 0) { %><%= titulo.slice(0, idx) %><em><%= resaltado %></em><%= titulo.slice(idx + resaltado.length) %><% } else { %><%= titulo %><% } %>
          </h1>
          <p class="hero__sub rise" style="--d:2"><%= settings.hero_subtitle %></p>
          <div class="hero__cta rise" style="--d:3">
            <a id="btn-hero-registro" class="btn btn--primary" href="/auth/registro">Crear cuenta gratis <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            <a id="btn-hero-demo" class="btn btn--ghost" href="<%= wa %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp" aria-hidden="true"></i>Hablar por WhatsApp</a>
          </div>
          <p class="hero__note rise" style="--d:4"><i class="bi bi-check2-circle" aria-hidden="true"></i>Se crea en un minuto. Sin instalar nada: funciona desde el navegador.</p>
        </div>

        <div class="mock reveal" role="img" aria-label="Ilustración de ejemplo: pantalla de cocina con tres pedidos y la ficha de costo de una hamburguesa con 62% de margen">
          <div class="mock__panel" aria-hidden="true">
            <div class="mock__bar">Pantalla de cocina <span>3 pedidos activos</span></div>
            <div class="tickets" id="kds">
              <div class="tw"><div class="tw__in"><div class="ticket">
                <div class="ticket__mesa">4</div>
                <div><div class="ticket__name">Mesa 4</div><div class="ticket__items">2 × Hamburguesa clásica · 1 × Limonada</div></div>
                <span class="chip chip--ok">02:10</span>
              </div></div></div>
              <div class="tw"><div class="tw__in"><div class="ticket ticket--late">
                <div class="ticket__mesa">7</div>
                <div><div class="ticket__name">Mesa 7</div><div class="ticket__items">1 × Bandeja paisa · 2 × Jugo natural</div></div>
                <span class="chip chip--warn">14:35</span>
              </div></div></div>
              <div class="tw"><div class="tw__in"><div class="ticket">
                <div class="ticket__mesa">2</div>
                <div><div class="ticket__name">Domicilio</div><div class="ticket__items">3 × Perro caliente</div></div>
                <span class="chip chip--ok">05:48</span>
              </div></div></div>
            </div>
          </div>
          <div class="margin-card" id="margen" aria-hidden="true">
            <div class="margin-card__t">Ficha técnica</div>
            <div class="margin-card__n">Hamburguesa clásica</div>
            <div class="margin-card__row"><span>Costo de receta</span><b id="m-costo">$ 8.420</b></div>
            <div class="margin-card__row"><span>Precio de venta</span><b>$ 22.000</b></div>
            <div class="bar" id="m-barra"><i id="m-barra-i"></i></div>
            <div class="margin-card__alert"><i class="bi bi-arrow-up-right" aria-hidden="true"></i>Proveedor subió la carne: costo recalculado</div>
            <div class="margin-card__pct"><strong id="m-pct">62%</strong><span>margen</span></div>
          </div>
          <span class="mock__tag">Ejemplo ilustrativo con datos de muestra.</span>
        </div>
      </div>
    </section>

    <!-- CAPACIDADES -->
    <div class="wrap">
      <div class="strip">
        <div class="strip__track">
          <% [false, true].forEach(copia => { %>
          <ul class="strip__in"<%- copia ? ' aria-hidden="true"' : '' %>>
            <li class="strip__item"><i class="bi bi-receipt" aria-hidden="true"></i>Facturación electrónica</li>
            <li class="strip__item"><i class="bi bi-qr-code" aria-hidden="true"></i>Menú QR para tus mesas</li>
            <li class="strip__item"><i class="bi bi-display" aria-hidden="true"></i>Cocina en tiempo real</li>
            <li class="strip__item"><i class="bi bi-boxes" aria-hidden="true"></i>Inventario y recetas</li>
            <li class="strip__item"><i class="bi bi-phone" aria-hidden="true"></i>Celular, tablet y PC</li>
            <li class="strip__item"><i class="bi bi-cash-coin" aria-hidden="true"></i>Caja y arqueos</li>
          </ul>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- PROBLEMAS -->
    <section class="section wrap">
      <div class="problems">
        <div class="section-head reveal">
          <span class="eyebrow eyebrow--warm">El problema</span>
          <h2 class="h2"><%= settings.problems_title %></h2>
          <p class="lead"><%= settings.problems_subtitle %></p>
        </div>
        <div class="problem-list">
          <% [1, 2, 3, 4].forEach(n => { %>
          <div class="problem reveal" style="--i:<%= n - 1 %>">
            <span class="problem__n">0<%= n %></span>
            <div><h3><%= settings['problem' + n + '_title'] %></h3><p><%= settings['problem' + n + '_desc'] %></p></div>
          </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- FUNCIONES -->
    <section id="funciones" class="section wrap">
      <div class="section-head reveal">
        <span class="eyebrow">La solución</span>
        <h2 class="h2"><%= settings.features_title %></h2>
        <p class="lead"><%= settings.features_subtitle %></p>
      </div>
      <% const iconos = ['clipboard-data', 'display', 'box-seam', 'shield-lock', 'grid-3x3-gap', 'patch-check']; %>
      <% const tamanos = ['xl', 'lg', 'lg', 'xl', 'md', 'md']; %>
      <div class="bento">
        <% [1, 2, 3, 4, 5, 6].forEach(n => { %>
        <article class="card card--<%= tamanos[n - 1] %> reveal" style="--i:<%= (n - 1) % 2 %>">
          <span class="card__icon"><i class="bi bi-<%= iconos[n - 1] %>" aria-hidden="true"></i></span>
          <h3><%= settings['feature' + n + '_title'] %></h3>
          <p><%= settings['feature' + n + '_desc'] %></p>
        </article>
        <% }) %>
      </div>
    </section>

    <!-- CÓMO EMPEZAR -->
    <section id="empezar" class="section wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Cómo empezar</span>
        <h2 class="h2">Operando en tres pasos, sin instalar nada</h2>
        <p class="lead">Empiezas con lo básico y vas activando módulos cuando tu operación los necesite.</p>
      </div>
      <div class="story">
        <div class="story__steps">
          <div class="step" data-scene="0"><h3>Crea tu cuenta</h3><p>Registra tu restaurante con tu correo. Es gratis y toma un minuto.</p></div>
          <div class="step" data-scene="1"><h3>Carga tu carta</h3><p>Agrega productos, insumos y recetas para conocer el costo real de cada plato.</p></div>
          <div class="step" data-scene="2"><h3>Abre tu primera mesa</h3><p>Toma pedidos, envíalos a cocina y cierra la caja con todo trazado.</p></div>
        </div>
        <div class="story__stage" role="img" aria-label="Ilustración de ejemplo: registro de la cuenta, carga de productos con su margen y mapa de mesas">
          <div class="scene on" data-scene="0" aria-hidden="true">
            <div class="mock__panel">
              <div class="mock__bar">Crear cuenta <span>1 minuto</span></div>
              <div class="scene__body">
                <div class="field"><small>Nombre del restaurante</small><span class="field--type"><span>La Esquina del Sabor</span></span></div>
                <div class="field"><small>Correo</small><span>admin@laesquina.co</span></div>
                <div class="field"><small>Contraseña</small><span>••••••••••</span></div>
                <div class="field field--btn"><span>Crear cuenta gratis</span></div>
              </div>
            </div>
          </div>
          <div class="scene" data-scene="1" aria-hidden="true">
            <div class="mock__panel">
              <div class="mock__bar">Productos <span>costo y margen</span></div>
              <div class="scene__body">
                <div class="prod"><b>Hamburguesa clásica</b><span>$ 22.000</span><span class="chip chip--ok">62%</span></div>
                <div class="prod"><b>Limonada de coco</b><span>$ 6.000</span><span class="chip chip--ok">74%</span></div>
                <div class="prod"><b>Bandeja paisa</b><span>$ 32.000</span><span class="chip chip--warn">55%</span></div>
                <div class="prod"><b>Perro caliente</b><span>$ 12.000</span><span class="chip chip--ok">66%</span></div>
              </div>
            </div>
          </div>
          <div class="scene" data-scene="2" aria-hidden="true">
            <div class="mock__panel">
              <div class="mock__bar">Mapa de mesas <span>3 ocupadas</span></div>
              <div class="scene__body">
                <div class="mesas">
                  <div class="mesa">1</div><div class="mesa mesa--busy">2</div><div class="mesa">3</div><div class="mesa mesa--kitchen">4</div>
                  <div class="mesa">5</div><div class="mesa">6</div><div class="mesa mesa--busy">7</div><div class="mesa">8</div>
                </div>
                <div class="total"><span>Mesa 4 · 2 productos en cocina</span><em>$ 50.000</em></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PLANES -->
    <section id="precios" class="section wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Planes</span>
        <h2 class="h2"><%= settings.plans_title %></h2>
        <p class="lead"><%= settings.plans_subtitle %></p>
      </div>
      <div class="plans">
        <div class="plan reveal" style="--i:0">
          <h3><%= settings.plan1_title %></h3>
          <p class="plan__desc"><%= settings.plan1_desc %></p>
          <ul class="plan__list"><% lista(settings.plan1_features).forEach(f => { %><li><i class="bi bi-check-lg" aria-hidden="true"></i><%= f %></li><% }) %></ul>
          <a id="btn-plan-operativo" class="btn btn--ghost btn--block" href="<%= waPlan('Hola, quiero información del Plan Operativo de GastroFlow') %>" target="_blank" rel="noopener noreferrer">Consultar plan</a>
        </div>
        <div class="plan plan--featured reveal" style="--i:1">
          <span class="plan__badge">Recomendado</span>
          <h3><%= settings.plan2_title %></h3>
          <p class="plan__desc"><%= settings.plan2_desc %></p>
          <ul class="plan__list"><% lista(settings.plan2_features).forEach(f => { %><li><i class="bi bi-check-lg" aria-hidden="true"></i><%= f %></li><% }) %></ul>
          <a id="btn-plan-pro" class="btn btn--primary btn--block" href="<%= waPlan('Hola, me gustaría agendar una demo del Plan Control Pro') %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp" aria-hidden="true"></i>Agendar demo</a>
        </div>
        <div class="plan reveal" style="--i:2">
          <h3><%= settings.plan3_title %></h3>
          <p class="plan__desc"><%= settings.plan3_desc %></p>
          <ul class="plan__list"><% lista(settings.plan3_features).forEach(f => { %><li><i class="bi bi-check-lg" aria-hidden="true"></i><%= f %></li><% }) %></ul>
          <a id="btn-plan-premium" class="btn btn--ghost btn--block" href="<%= waPlan('Hola, me gustaría contactar a ventas por el Plan Premium') %>" target="_blank" rel="noopener noreferrer">Contactar ventas</a>
        </div>
      </div>
      <p class="plans__note">¿Aún no sabes cuál te conviene? <a href="/auth/registro" style="color:var(--color-primary);font-weight:700;">Crea tu cuenta gratis</a> y lo hablamos.</p>
    </section>

    <!-- CTA FINAL -->
    <section class="section wrap">
      <div class="cta reveal">
        <h2><%= settings.cta_title %></h2>
        <p><%= settings.cta_subtitle %></p>
        <div class="cta__btns">
          <a id="btn-cta-registro" class="btn btn--primary" href="/auth/registro">Crear cuenta gratis <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
          <a id="btn-cta-demo" class="btn btn--ghost" href="<%= wa %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp" aria-hidden="true"></i>Solicitar demo</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <a class="brand" href="#top"><span class="brand__mark"><i class="bi bi-fire" aria-hidden="true"></i></span>GastroFlow</a>
        <p class="footer__about">El sistema operativo para el éxito de tu restaurante. Control, velocidad y rentabilidad en una sola plataforma.</p>
      </div>
      <div>
        <h4>Producto</h4>
        <ul>
          <li><a href="#funciones">Funciones</a></li>
          <li><a href="#empezar">Cómo empezar</a></li>
          <li><a href="#precios">Planes</a></li>
        </ul>
      </div>
      <div>
        <h4>Soporte y legal</h4>
        <ul>
          <li><a href="https://wa.me/<%= settings.whatsapp_number %>" target="_blank" rel="noopener noreferrer">Contacto por WhatsApp</a></li>
          <li><a href="/legal/privacidad">Privacidad</a></li>
          <li><a href="/legal/terminos">Términos</a></li>
          <li><a href="/legal/cookies">Cookies</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer__legal">© <%= new Date().getFullYear() %> GastroFlow Technologies. Todos los derechos reservados.</div>
  </footer>

  <script src="/js/modulos/landing.js?v=<%= assetV %>"></script>
</body>
</html>
