<%- include('../partials/layout/head', { titulo: 'Gestión de Productos' }) %>
    <link rel="stylesheet" href="/css/modulos/productos.css?v=<%= assetV %>">
    <link rel="stylesheet" href="/css/modulos/carta_foto.css?v=<%= assetV %>">
    <% const activeAccent = colorAcento(typeof tenant !== 'undefined' ? tenant : null) %>
    <%- include('../partials/layout/accent-vars', { color: activeAccent, selector: ':root' }) %>
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null, tenant: typeof tenant !== 'undefined' ? tenant : null }) %>

    <div class="container animate__animated animate__fadeIn">
        
        <!-- Header Section -->
        <div class="page-header-container">
            <div class="page-title-section">
                <span class="page-title-icon">
                    <i class="bi bi-box-seam"></i>
                </span>
                <div class="page-title-text">
                    <h1>Gestión de productos</h1>
                    <p id="productCountLabel"><%= productos.length %> de <%= productos.length %> productos en catálogo</p>
                </div>
            </div>
            
            <div class="header-actions">
                <% if (typeof allowedByPlan !== 'undefined' && allowedByPlan && allowedByPlan.plantillas && user && user.permisos && user.permisos.includes('plantillas.ver')) { %>
                    <button id="btnDescargarPlantilla" class="btn-premium-outline">
                        <i class="bi bi-file-earmark-excel"></i> Plantilla Excel
                    </button>
                    <button id="btnImportarProductos" class="btn-premium-outline">
                        <i class="bi bi-upload"></i> Importar Excel
                    </button>
                    <input type="file" id="archivoImport" accept=".xlsx" class="d-none">
                <% } %>
                <% if (typeof cartaFotoDisponible !== 'undefined' && cartaFotoDisponible && user && user.permisos && user.permisos.includes('productos.crear')) { %>
                    <button id="btnCartaFoto" class="btn-premium-outline" data-bs-toggle="modal" data-bs-target="#cartaFotoModal">
                        <i class="bi bi-camera"></i> Carta desde foto
                    </button>
                <% } %>
                <% if (user && user.permisos && user.permisos.includes('productos.crear')) { %>
                    <button class="btn-premium-action" data-bs-toggle="modal" data-bs-target="#nuevoProductoModal">
                        <i class="bi bi-plus-lg"></i> Nuevo producto
                    </button>
                <% } %>
            </div>
        </div>

        <!-- Search & Filter Controls -->
        <div class="filters-row">
            <div class="search-input-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="buscarProducto" placeholder="Buscar producto por nombre o código...">
            </div>
            
            <!-- Category Filter Chips -->
            <%- include('_category_filter') %>
        </div>

        <!-- Products Table -->
        <%- include('_table', { productos: productos, recetasPorProducto: typeof recetasPorProducto !== 'undefined' ? recetasPorProducto : {} }) %>

    </div>

    <!-- Modals -->
    <%- include('_modal_costeo') %>
    <%- include('_modal_modificadores') %>
    <% if (typeof cartaFotoDisponible !== 'undefined' && cartaFotoDisponible) { %><%- include('_modal_carta_foto') %><% } %>
    <%- include('_modal_form', { categorias: categorias, tenant: typeof tenant !== 'undefined' ? tenant : null }) %>

    <!-- Base Scripts -->
    <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
    
    <!-- Load modules -->
    <script src="/js/core/money-input.js?v=<%= assetV %>"></script>
    <script src="/js/core/modules/SearchManager.js?v=<%= assetV %>"></script>
    <script src="/js/core/modules/FormManager.js?v=<%= assetV %>"></script>
    <script src="/js/core/modules/TableManager.js?v=<%= assetV %>"></script>
    
    <!-- Load main script -->
    <script src="/js/modulos/productos/productos_core.js?v=<%= assetV %>"></script>
    <script src="/js/modulos/productos/productos_ui.js?v=<%= assetV %>"></script>
    <% if (typeof cartaFotoDisponible !== 'undefined' && cartaFotoDisponible) { %>
    <script src="/js/modulos/productos/carta_foto.js?v=<%= assetV %>"></script>
    <% } %>
</body>

</html>