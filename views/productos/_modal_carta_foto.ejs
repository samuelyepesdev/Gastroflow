<!-- Importar la carta desde una foto: 1) elegir foto, 2) revisar el borrador, 3) resultado -->
<div class="modal fade" id="cartaFotoModal" tabindex="-1" aria-labelledby="cartaFotoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cartaFotoTitulo"><i class="bi bi-camera me-2"></i>Importar carta desde una foto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- Paso 1: foto -->
                <section id="cfPaso1">
                    <p class="mb-2">Toma o sube una foto de tu carta y crearemos los productos por ti. Antes de guardar nada podrás revisar y corregir todo.</p>
                    <ul class="cf-consejos">
                        <li>Que se vea toda la carta, de frente y con buena luz.</li>
                        <li>Si tiene varias páginas, importa una foto a la vez.</li>
                        <li>La foto se envía a un servicio de IA para leerla y <strong>no se guarda</strong>.</li>
                    </ul>
                    <label for="cfArchivo" class="cf-subir">
                        <i class="bi bi-image" aria-hidden="true"></i>
                        <span id="cfArchivoTexto">Elegir o tomar una foto</span>
                    </label>
                    <input type="file" id="cfArchivo" accept="image/jpeg,image/png,image/webp" capture="environment" class="visually-hidden">
                    <img id="cfPrevia" class="cf-previa d-none" alt="Vista previa de la foto de tu carta">
                    <div id="cfError" class="alert alert-danger mt-3 d-none" role="alert"></div>
                </section>

                <!-- Cargando -->
                <section id="cfCargando" class="cf-cargando d-none" aria-live="polite">
                    <div class="spinner-border" role="status" aria-hidden="true"></div>
                    <p class="mt-3 mb-0 fw-semibold">Leyendo tu carta…</p>
                    <p class="text-muted small mb-0">Puede tardar hasta un minuto si la carta es larga.</p>
                </section>

                <!-- Paso 2: revisión -->
                <section id="cfPaso2" class="d-none">
                    <div class="alert alert-warning small" role="alert">
                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                        La IA puede equivocarse. Revisa los <strong>nombres y precios</strong> antes de importar. Desmarca lo que no quieras crear.
                    </div>
                    <p id="cfResumenLectura" class="small text-muted mb-2" aria-live="polite"></p>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" id="cfTodos" checked>
                        <label class="form-check-label small" for="cfTodos">Seleccionar todos</label>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle cf-tabla no-stack">
                            <thead>
                                <tr>
                                    <th scope="col" style="width: 2rem"><span class="visually-hidden">Importar</span></th>
                                    <th scope="col">Producto</th>
                                    <th scope="col" style="width: 28%">Categoría</th>
                                    <th scope="col" style="width: 22%">Precio</th>
                                </tr>
                            </thead>
                            <tbody id="cfFilas"></tbody>
                        </table>
                    </div>
                </section>

                <!-- Paso 3: resultado -->
                <section id="cfPaso3" class="d-none" aria-live="polite">
                    <div class="text-center mb-3">
                        <i class="bi bi-check-circle cf-ok" aria-hidden="true"></i>
                        <h3 class="h5 mt-2" id="cfResultadoTitulo"></h3>
                    </div>
                    <div id="cfResultadoDetalle"></div>
                </section>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="cfCerrar">Cancelar</button>
                <button type="button" class="btn btn-outline-secondary d-none" id="cfOtra">Otra foto</button>
                <button type="button" class="btn btn-primary" id="cfLeer" disabled><i class="bi bi-magic me-1"></i>Leer carta</button>
                <button type="button" class="btn btn-primary d-none" id="cfImportar"><i class="bi bi-check-lg me-1"></i><span id="cfImportarTexto">Importar</span></button>
                <button type="button" class="btn btn-primary d-none" id="cfListo">Ver productos</button>
            </div>
        </div>
    </div>
</div>
