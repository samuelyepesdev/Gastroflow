<%- include('../partials/layout/auth-head', { titulo: (title || 'Iniciar Sesión') + ' | GastroFlow', swal: true, seo: { description: 'Inicia sesión en GastroFlow, el sistema de gestión inteligente para restaurantes: ventas, inventario, cocina y costeo en tiempo real.', canonical: 'https://gastroflow.digital/auth/login' } }) %>
<body>

    <!-- ── Panel izquierdo: marca ── -->
    <aside class="login-brand">
        <a href="/" class="brand-top" style="text-decoration: none;">
            <img class="brand-icon" src="/brand/isotipo/isotipo-oscuro.svg" alt="" width="44" height="44">
            <span class="brand-name">GASTROFLOW</span>
        </a>

        <div class="brand-center">
            <h2 class="brand-headline">
                Gestiona tu<br>negocio <span>sin límites</span>
            </h2>
            <p class="brand-sub">
                Control total de mesas, ventas, inventario y facturación
                desde un solo lugar.
            </p>
        </div>

        <div class="brand-features">
            <div class="feat-item">
                <div class="feat-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                Gestión de mesas en tiempo real
            </div>
            <div class="feat-item">
                <div class="feat-icon"><i class="bi bi-receipt"></i></div>
                Facturación rápida e intuitiva
            </div>
            <div class="feat-item">
                <div class="feat-icon"><i class="bi bi-boxes"></i></div>
                Control de inventario y costos
            </div>
            <div class="feat-item">
                <div class="feat-icon"><i class="bi bi-bar-chart-line"></i></div>
                Analítica y reportes en vivo
            </div>
        </div>
    </aside>

    <!-- ── Panel derecho: formulario ── -->
    <main class="login-form-side">
        <div class="login-card">

            <a href="/" class="mobile-logo" style="text-decoration: none;">
                <img class="mobile-logo-icon" src="/brand/isotipo/isotipo-color.svg" alt="" width="40" height="40">
                <span class="mobile-logo-text">GASTROFLOW</span>
            </a>

            <video class="brand-anim" autoplay muted loop playsinline preload="auto" poster="/brand/isotipo/isotipo-color.png" aria-hidden="true">
                <source src="/brand/animacion/videos/isotipo-revelado-transparente-1080.webm" type="video/webm">
            </video>

            <h1 class="login-title">Bienvenido</h1>
            <p class="login-subtitle">Ingresa tus credenciales para continuar</p>

            <!-- Alerta de error -->
            <div id="errorAlert" class="login-alert error" style="display:none;" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span id="errorMsg"></span>
            </div>

            <!-- Mensaje de tenant / sesión expirada -->
            <% if (typeof mensaje !=='undefined' && mensaje) { %>
                <div class="login-alert warning" role="alert" id="mensajeTenant">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensaje %>
                </div>
                <% } %>

                    <!-- Formulario -->
                    <form id="loginForm" autocomplete="off" novalidate>

                        <div>
                            <label for="username" class="field-label">Usuario</label>
                            <div class="field-wrap">
                                <input type="text" class="field-input" id="username" name="username"
                                    placeholder="tu_usuario" required autofocus autocomplete="username">
                                <i class="bi bi-person field-icon"></i>
                            </div>
                        </div>

                        <div>
                            <label for="password" class="field-label">Contraseña</label>
                            <div class="field-wrap">
                                <input type="password" class="field-input has-toggle" id="password" name="password"
                                    placeholder="••••••••" required autocomplete="current-password">
                                <i class="bi bi-lock field-icon"></i>
                                <button type="button" class="pwd-toggle" id="togglePwd" aria-label="Mostrar contraseña"
                                    tabindex="-1">
                                    <i class="bi bi-eye" id="togglePwdIcon"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn-login" id="btnLogin">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Iniciar sesión
                        </button>
                    </form>

                    <p class="login-footer">
                        ¿No tienes cuenta? <a href="/auth/registro" style="color:inherit;font-weight:600;">Regístrate</a>
                    </p>
                    <p class="login-footer">
                        &copy; <%= new Date().getFullYear() %> GastroFlow &nbsp;·&nbsp;
                        <a href="/legal/privacidad" style="color:inherit;text-decoration:underline;opacity:0.75;">Privacidad</a>
                        &nbsp;·&nbsp;
                        <a href="/legal/terminos" style="color:inherit;text-decoration:underline;opacity:0.75;">Términos</a>
                    </p>
                    <%- include('../partials/_version') %>
        </div>

    </main>

    <!-- Bienvenida post-login: animación de marca (se muestra desde public/js/auth/login.js) -->
    <div id="bienvenida" class="bienvenida" hidden role="status" aria-live="polite">
        <video id="bienvenidaVideo" class="bienvenida-video" muted playsinline preload="auto" aria-hidden="true">
            <source src="/brand/animacion/videos/logo-animado-oscuro-1920x1080.mp4" type="video/mp4">
        </video>
        <p id="bienvenidaSaludo" class="bienvenida-saludo"></p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/core/gf.js?v=<%= assetV %>"></script>
    <script src="/js/auth/login.js?v=<%= assetV %>"></script>
</body>

</html>