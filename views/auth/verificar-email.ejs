<%- include('../partials/layout/auth-head', { titulo: (title || 'Verificar correo') + ' - Sistema de Restaurante' }) %>
<body>
    <main class="login-form-side" style="width:100%;">
        <div class="login-card">
            <a href="/" class="mobile-logo" style="text-decoration: none;">
                <img class="mobile-logo-icon" src="/brand/isotipo/isotipo-color.svg" alt="" width="40" height="40">
                <span class="mobile-logo-text">GASTROFLOW</span>
            </a>

            <% if (ok) { %>
                <h1 class="login-title">¡Correo verificado!</h1>
                <p class="login-subtitle">Ya puedes continuar creando tu local.</p>
            <% } else { %>
                <div class="login-alert error" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Este link de verificación no es válido o ya venció.</span>
                </div>
                <p class="login-subtitle">Ingresa tu correo y te reenviamos el link.</p>

                <form id="reenviarForm" autocomplete="off" novalidate>
                    <div>
                        <label for="email" class="field-label">Correo electrónico</label>
                        <div class="field-wrap">
                            <input type="email" class="field-input" id="email" name="email"
                                placeholder="tu@correo.com" required autocomplete="email">
                            <i class="bi bi-envelope field-icon"></i>
                        </div>
                    </div>
                    <button type="submit" class="btn-login" id="btnReenviar">
                        <i class="bi bi-arrow-repeat"></i>
                        Reenviar correo de verificación
                    </button>
                </form>
                <div id="reenviarMsg" class="login-alert" style="display:none;margin-top:1rem;"></div>
            <% } %>

            <p class="login-footer" style="margin-top:1.5rem;">
                <a href="/auth/login" style="color:inherit;font-weight:600;">Volver a iniciar sesión</a>
            </p>
        </div>
    </main>

    <script src="/js/core/gf.js?v=<%= assetV %>"></script>
    <script src="/js/auth/verificar-email.js?v=<%= assetV %>"></script>
</body>

</html>
